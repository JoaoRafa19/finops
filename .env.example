# Banco de dados
DATABASE_URL=postgres://finops:finops@localhost:5432/finops?sslmode=disable

# Redis (use REDIS_URL para connection string completa, ou REDIS_ADDR + REDIS_PASSWORD)
REDIS_URL=
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# LLM — Groq (produção) ou Ollama (local)
# Groq: https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Ollama local (alternativa):
# LLM_BASE_URL=http://localhost:11434
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# Embeddings para busca semântica de classificações
# Por defeito usa o mesmo servidor do LLM (funciona com Ollama).
# Para Groq (que não suporta embeddings), configure um servidor separado.
# Modelo recomendado Ollama: nomic-embed-text  |  OpenAI: text-embedding-3-small
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=nomic-embed-text

# App
HTTP_ADDR=:8080
APP_BASE_URL=http://localhost:8080

# SMTP para reset de senha
# Sem SMTP_HOST configurado, o link é apenas logado no servidor (modo desenvolvimento).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@seudominio.com
COOKIE_SECURE=false
SESSION_TTL=30m
REMEMBER_ME_TTL=168h
SLIDING_SESSION_TTL=true
LOG_LEVEL=info
SESSION_COOKIE_NAME=finops_session
