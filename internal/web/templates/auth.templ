package templates

templ LoginPage(errorMessage string) {
	<!DOCTYPE html>
	<html lang="pt-BR">
		@AppHead("Login - Finops", true)
		<body class="min-h-screen bg-[radial-gradient(circle_at_top,_#99f6e4_0%,_#f8fafc_35%,_#e2e8f0_100%)] font-display text-finops-900">
			<main class="mx-auto flex min-h-screen max-w-6xl items-center px-4 py-12 sm:px-6">
				<section
					id="auth-page"
					data-mode="login"
					class="relative w-full overflow-hidden rounded-3xl border border-white/80 bg-white/80 shadow-2xl shadow-finops-900/15 backdrop-blur-sm"
				>
					<!-- Grid com os dois formulários empilhados (desktop: lado a lado) -->
					<div class="relative min-h-[520px] lg:grid lg:grid-cols-2">

						<!-- Slot esquerdo: formulário de signup (fica estático) -->
						<div id="signup-area" class="p-7 sm:p-10">
							<div class="mb-7">
								<p class="text-xs font-bold uppercase tracking-[0.2em] text-finops-500">Novo por aqui</p>
								<h2 class="mt-3 text-3xl font-extrabold text-finops-900">Criar sua conta</h2>
								<p class="mt-2 text-sm text-finops-700">Preencha os dados para começar.</p>
							</div>
							<div id="signup-box">
								@SignupForm("")
							</div>
							<div class="mt-6 text-center">
								<p class="text-sm text-finops-700">
									Já tem uma conta?
									<button onclick="authGoLogin()" class="ml-1 font-bold text-finops-500 underline underline-offset-4 transition hover:text-finops-900">Entrar</button>
								</p>
							</div>
						</div>

						<!-- Slot direito: formulário de login (fica estático) -->
						<div id="login-area" class="p-7 sm:p-10">
							<div class="mb-7">
								<p class="text-xs font-bold uppercase tracking-[0.2em] text-finops-500">Acesso seguro</p>
								<h2 class="mt-3 text-3xl font-extrabold text-finops-900">Entrar na sua conta</h2>
								<p class="mt-2 text-sm text-finops-700">Use seu email e senha para continuar.</p>
							</div>
							<div id="login-box">
								@LoginForm(errorMessage)
							</div>
							<div class="mt-6 text-center">
								<p class="text-sm text-finops-700">
									Não tem conta?
									<button onclick="authGoSignup()" class="ml-1 font-bold text-finops-500 underline underline-offset-4 transition hover:text-finops-900">Criar conta</button>
								</p>
							</div>
						</div>

						<!-- Painel azul: overlay absoluto que desliza sobre os formulários -->
						<!-- Começa cobrindo o slot esquerdo (signup), desliza para direita ao clicar em "Criar conta" -->
						<div
							id="auth-panel"
							class="absolute inset-y-0 left-0 hidden w-1/2 bg-finops-900 lg:block"
							style="transition: transform 0.5s cubic-bezier(0.4,0,0.2,1);"
						>
							<div class="absolute inset-0 bg-[linear-gradient(145deg,rgba(15,23,42,1)_0%,rgba(15,23,42,0.9)_45%,rgba(13,148,136,0.8)_100%)]"></div>
							<div id="auth-panel-content" class="relative z-10 flex h-full flex-col justify-between p-10 text-slate-100">
								<div>
									<p class="text-xs uppercase tracking-[0.2em] text-finops-400">Finops</p>
									<h1 id="auth-panel-title" class="mt-4 text-4xl font-extrabold leading-tight">Seu controle financeiro, sem planilha.</h1>
								</div>
								<p id="auth-panel-sub" class="max-w-sm text-sm text-slate-200/90">Centralize contas, acompanhe movimentações e construa consistência financeira no seu ritmo.</p>
							</div>
						</div>

					</div>
				</section>
			</main>
			<style>
				/* Mobile: mostra só o formulário ativo */
				@media (max-width: 1023px) {
					[data-mode="login"] #signup-area  { display: none; }
					[data-mode="signup"] #login-area  { display: none; }
				}
				/* Desktop: ambos os formulários sempre renderizados (painel cobre o inativo) */
				@media (min-width: 1024px) {
					#signup-area, #login-area { display: block !important; }
				}
			</style>
			<script>
				const PANEL_TEXTS = {
					login:  { title: "Seu controle financeiro, sem planilha.",      sub: "Centralize contas, acompanhe movimentações e construa consistência financeira no seu ritmo." },
					signup: { title: "Já tem uma conta?",                           sub: "Entre com seu email e senha para continuar de onde parou." },
				};

				function authGoSignup() {
					// Painel desliza para a direita (cobre o formulário de login)
					document.getElementById("auth-panel").style.transform = "translateX(100%)";
					document.getElementById("auth-page").setAttribute("data-mode", "signup");
					_updatePanelText("signup");
				}

				function authGoLogin() {
					// Painel volta para a esquerda (cobre o formulário de signup)
					document.getElementById("auth-panel").style.transform = "translateX(0)";
					document.getElementById("auth-page").setAttribute("data-mode", "login");
					_updatePanelText("login");
				}

				function _updatePanelText(mode) {
					const t = PANEL_TEXTS[mode];
					if (!t) return;
					document.getElementById("auth-panel-title").textContent = t.title;
					document.getElementById("auth-panel-sub").textContent   = t.sub;
				}
			</script>
		</body>
	</html>
}

templ SignupForm(errorMessage string) {
	if errorMessage != "" {
		<div class="mb-5 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-medium text-rose-700">
			{ errorMessage }
		</div>
	}
	<form
		method="post"
		action="/signup"
		hx-post="/signup"
		hx-target="#signup-box"
		hx-swap="innerHTML"
		class="space-y-5"
	>
		<div>
			@FormLabel("signup-email", "Email")
			@TextInput("signup-email", "email", "email", "", "voce@exemplo.com", true)
		</div>
		<div>
			@FormLabel("signup-password", "Senha")
			@TextInput("signup-password", "password", "password", "", "Mínimo 8 caracteres", true)
			<div class="mt-2 flex items-center gap-2" aria-live="polite">
				<div class="h-1.5 flex-1 overflow-hidden rounded-full bg-slate-200">
					<div id="pw-strength-bar" class="h-full w-0 rounded-full bg-rose-400 transition-all duration-200"></div>
				</div>
				<span id="pw-strength-label" class="w-16 text-right text-xs font-semibold text-slate-500"></span>
			</div>
			<ul id="pw-hints" class="mt-2 space-y-0.5 text-xs text-slate-500">
				<li data-rule="len">• Pelo menos 8 caracteres</li>
				<li data-rule="mix">• Letras e números</li>
				<li data-rule="sym">• Símbolo (opcional, aumenta a força)</li>
			</ul>
		</div>
		<div>
			@FormLabel("signup-confirm", "Confirmar senha")
			@TextInput("signup-confirm", "confirm_password", "password", "", "Repita a senha", true)
		</div>
		@PrimaryButton("submit", "Criar conta", true)
	</form>
	<script>
		(function() {
			const pw    = document.getElementById("signup-password");
			const bar   = document.getElementById("pw-strength-bar");
			const label = document.getElementById("pw-strength-label");
			const hints = document.getElementById("pw-hints");
			if (!pw || !bar) return;

			function score(v) {
				let s = 0;
				const rules = {
					len: v.length >= 8,
					mix: /[a-zA-Z]/.test(v) && /[0-9]/.test(v),
					sym: /[^a-zA-Z0-9]/.test(v),
				};
				if (rules.len) s++;
				if (rules.mix) s++;
				if (rules.sym) s++;
				if (v.length >= 12) s++;
				return { s, rules };
			}
			const LABELS = ["Muito fraca", "Fraca", "Média", "Boa", "Forte"];
			const COLORS = ["#f43f5e", "#f97316", "#eab308", "#22c55e", "#0d9488"];
			const WIDTHS = ["10%", "25%", "50%", "75%", "100%"];

			pw.addEventListener("input", () => {
				if (!pw.value) { bar.style.width = "0%"; label.textContent = ""; return; }
				const { s, rules } = score(pw.value);
				bar.style.width           = WIDTHS[s];
				bar.style.backgroundColor = COLORS[s];
				label.textContent         = LABELS[s];
				label.style.color         = COLORS[s];
				hints.querySelectorAll("li").forEach(li => {
					const ok = rules[li.dataset.rule];
					li.style.color = ok ? "#0d9488" : "";
					li.style.fontWeight = ok ? "600" : "";
				});
			});
		})();
	</script>
}
