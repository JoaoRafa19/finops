package templates

import (
	"finops/internal/store"
	"finops/internal/utils"
	"fmt"
	"strings"
	"time"
)

type TransactionDTO struct {
	ID          int
	Description string
	Amount      float64
	Category    string
	CreatedAt   time.Time
	Account     string
	Direction   string
	Currency    string
}

func transactionCategoryLabel(category string) string {
	if strings.TrimSpace(category) == "" {
		return "Sem categoria"
	}

	return category
}

func transactionDirectionLabel(direction string) string {
	switch strings.TrimSpace(direction) {
	case "credit":
		return "Entrada"
	case "debit":
		return "Saida"
	default:
		return "Movimento"
	}
}

func transactionAmountLabel(tx TransactionDTO) string {
	amount := tx.Amount
	if strings.TrimSpace(tx.Direction) == "debit" {
		amount = -amount
	}

	return utils.FormatMoney(amount)
}

func transactionAmountClass(direction string) string {
	if strings.TrimSpace(direction) == "credit" {
		return "text-sm font-bold text-emerald-700 tabular-nums whitespace-nowrap bg-green-200 px-2 py-1 rounded"
	}

	if strings.TrimSpace(direction) == "debit" {
		return "text-sm font-bold text-rose-700 tabular-nums whitespace-nowrap bg-rose-200 px-2 py-1 rounded"
	}

	return "text-sm font-bold text-finops-800 tabular-nums whitespace-nowrap bg-slate-200 px-2 py-1 rounded"
}

templ TransactionPanel(transactions []TransactionDTO) {
	<div id="transaction-panel" class="rounded-2xl border border-slate-200 bg-white p-6">
		<div class="flex flex-col items-start justify-between">
			<p class="text-lg font-bold text-finops-900">Transações Recentes</p>
			<p class="mt-1 text-sm text-finops-700">Últimos lançamentos registrados no workspace</p>
		</div>
		if len(transactions) > 0 {
			<ul class="mt-6 space-y-3" id="transactions-list">
				for _, tx := range transactions {
					@TransactionItem(tx)
				}
			</ul>
		} else {
			<p class="mt-6" id="empty-transaction-list">
				Nenhuma transação registrada ainda.
				Quando você registrar uma entrada, saída ou transferência, ela aparecerá aqui.
			</p>
		}
	</div>
}

templ TransactionItem(transaction TransactionDTO) {
	<li
		id={ fmt.Sprintf("transaction-%d", transaction.ID) }
		class="flex flex-col gap-3 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 sm:flex-row sm:items-center sm:justify-between"
	>
		<div>
			<p class="font-semibold text-finops-900">{ transaction.Description }</p>
			<p class="text-sm text-finops-700">
				{ transaction.CreatedAt.Format("02/01/2006") } • { transaction.Account } • { transactionCategoryLabel(transaction.Category) } • { transactionDirectionLabel(transaction.Direction) }
			</p>
		</div>
		<div class="flex items-center gap-3">
			<p class={ transactionAmountClass(transaction.Direction) }>{ transactionAmountLabel(transaction) }</p>
			if transaction.Direction != "transfer" {
				<button
					class="rounded-lg p-1.5 text-slate-400 transition hover:bg-slate-200 hover:text-finops-700"
					title="Editar transação"
					aria-label={ "Editar transação " + transaction.Description }
					hx-get={ fmt.Sprintf("/transactions/%d/edit-modal", transaction.ID) }
					hx-target="#transaction-modal-body"
					hx-swap="innerHTML"
					hx-on::after-request="document.getElementById('transaction-modal')?.showModal()"
				><i class="fa-solid fa-pen text-xs" aria-hidden="true"></i></button>
				<button
					class="rounded-lg p-1.5 text-slate-400 transition hover:bg-rose-100 hover:text-rose-600"
					title="Apagar transação"
					aria-label={ "Apagar transação " + transaction.Description }
					hx-delete={ fmt.Sprintf("/transactions/%d", transaction.ID) }
					hx-target={ fmt.Sprintf("#transaction-%d", transaction.ID) }
					hx-swap="outerHTML"
					hx-confirm="Apagar esta transação?"
				><i class="fa-solid fa-trash text-xs" aria-hidden="true"></i></button>
			}
		</div>
	</li>
}

templ TransactionEditModalDialog(txID int64, form TransactionFormState, csrf_token string, accounts []store.Account, categories []store.Category) {
	<div class="p-6">
		<div class="flex items-center justify-between">
			<p class="text-lg font-bold text-finops-900">Editar Transação</p>
			<form method="dialog">
				@DefaultCloseModalButton()
			</form>
		</div>
		if form.ErrorMessage != "" {
			<p class="mt-4 rounded-lg bg-red-100 px-4 py-3 text-sm text-red-700">{ form.ErrorMessage }</p>
		}
		<form
			hx-post={ fmt.Sprintf("/transactions/%d", txID) }
			hx-target="#transaction-modal-body"
			hx-swap="innerHTML"
			class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2"
		>
			<input type="hidden" name="_csrf" value={ csrf_token }/>
			<div class="md:col-span-2">
				@FormLabel("description", "Descrição")
				@TextInput("description", "description", "text", form.Description, "Compra no supermercado", true)
			</div>
			<div>
				@FormLabel("amount", "Valor")
				@TextInput("amount", "amount", "text", form.Amount, "0.00", true)
			</div>
			<div>
				@FormLabel("account_id", "Conta")
				@SelectInput("account_id", "account_id", buildAccountOptions(accounts, form.AccountID), true)
			</div>
			<div>
				@FormLabel("posted_on", "Data")
				@TextInput("posted_on", "posted_on", "date", form.PostedOn, "", true)
			</div>
			<div>
				@FormLabel("category_id", "Categoria")
				@SelectInput("category_id", "category_id", buildCategoryOptions(categories, form.CategoryID), true)
			</div>
			<div>
				@FormLabel("direction", "Tipo")
				@SelectInput("direction", "direction", buildTransactionDirectionOptions(form.Direction), true)
			</div>
			<div class="md:col-span-2 flex flex-col gap-3 sm:flex-row">
				@PrimaryButton("submit", "Salvar alterações", true)
			</div>
		</form>
	</div>
}

templ TransactionModalDialog(form TransactionFormState, csrf_token string, accounts []store.Account, categories []store.Category) {
	<div class="p-6">
		<div class="flex items-center justify-between">
			<p class="text-lg font-bold text-finops-900">Adicionar Transacao</p>
			<form method="dialog">
				@DefaultCloseModalButton()
			</form>
		</div>
		if form.ErrorMessage != "" {
			<p class="mt-4 rounded-lg bg-red-100 px-4 py-3 text-sm text-red-700">{ form.ErrorMessage }</p>
		}
		<form
			method="post"
			action="/transactions"
			hx-post="/transactions"
			hx-target="#transaction-modal-body"
			hx-swap="innerHTML"
			class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2"
		>
			<input type="hidden" name="_csrf" value={ csrf_token }/>
			<div class="md:col-span-2">
				@FormLabel("description", "Descrição")
				@TextInput("description", "description", "text", form.Description, "Compra no supermercado", true)
			</div>
			<div>
				@FormLabel("amount", "Valor")
				@TextInput("amount", "amount", "text", form.Amount, "0.00", true)
			</div>
			<div>
				@FormLabel("account_id", "Conta")
				@SelectInput("account_id", "account_id", buildAccountOptions(accounts, form.AccountID), true)
			</div>
			<div>
				@FormLabel("posted_on", "Data")
				@TextInput("posted_on", "posted_on", "date", form.PostedOn, "", true)
			</div>
			<div>
				@FormLabel("category_id", "Categoria")
				@SelectInput("category_id", "category_id", buildCategoryOptions(categories, form.CategoryID), true)
			</div>
			<div>
				@FormLabel("direction", "Tipo")
				@SelectInput("direction", "direction", buildTransactionDirectionOptions(form.Direction), true)
			</div>
			<div class="md:col-span-2 flex flex-col gap-3 sm:flex-row">
				@PrimaryButton("submit", "Adicionar Transação", true)
			</div>
		</form>
	</div>
}

templ TransferModalBlocked() {
	<div class="p-6">
		<div class="flex items-center justify-between">
			<p class="text-lg font-bold text-finops-900">Transferir entre contas</p>
			<form method="dialog">
				@DefaultCloseModalButton()
			</form>
		</div>
		<div class="mt-4 rounded-xl border-l-4 border-amber-400 bg-amber-50 p-4">
			<p class="text-sm text-amber-900">Cadastre ao menos duas contas para registrar uma transferência.</p>
		</div>
		<button
			type="button"
			hx-get="/account-modal"
			hx-target="#account-modal-body"
			hx-swap="innerHTML"
			hx-on::after-request="document.getElementById('transfer-modal')?.close(); document.getElementById('account-modal')?.showModal()"
			class="mt-6 inline-flex items-center gap-2 rounded-xl bg-finops-900 px-4 py-2.5 text-sm font-bold text-white transition hover:bg-finops-800"
		>
			<i class="fa-solid fa-plus" aria-hidden="true"></i> Cadastrar conta agora
		</button>
	</div>
}

templ TransferModalDialog(form TransferFormState, csrf_token string, accounts []store.Account) {
	<div class="p-6">
		<div class="flex items-center justify-between">
			<p class="text-lg font-bold text-finops-900">Transferir entre contas</p>
			<form method="dialog">
				@DefaultCloseModalButton()
			</form>
		</div>
		if form.ErrorMessage != "" {
			<p class="mt-4 rounded-lg bg-red-100 px-4 py-3 text-sm text-red-700">{ form.ErrorMessage }</p>
		}
		<form
			method="post"
			action="/transfers"
			hx-post="/transfers"
			hx-target="#transfer-modal-body"
			hx-swap="innerHTML"
			class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2"
		>
			<input type="hidden" name="_csrf" value={ csrf_token }/>
			<div>
				@FormLabel("from_account_id", "Conta de origem")
				@SelectInput("from_account_id", "from_account_id", buildAccountOptions(accounts, form.FromAccountID), true)
			</div>
			<div>
				@FormLabel("to_account_id", "Conta de destino")
				@SelectInput("to_account_id", "to_account_id", buildAccountOptions(accounts, form.ToAccountID), true)
			</div>
			<div>
				@FormLabel("amount", "Valor")
				@TextInput("amount", "amount", "text", form.Amount, "0.00", true)
			</div>
			<div>
				@FormLabel("posted_on", "Data")
				@TextInput("posted_on", "posted_on", "date", form.PostedOn, "", true)
			</div>
			<div class="md:col-span-2 flex flex-col gap-3 sm:flex-row">
				@PrimaryButton("submit", "Transferir", true)
			</div>
		</form>
	</div>
}
