package templates

templ VerifyEmailPending(email, csrf string, sent bool) {
	<!DOCTYPE html>
	<html lang="pt-BR">
		@AppHead("Confirme seu e-mail · Finops", true)
		<body class="min-h-screen bg-[radial-gradient(circle_at_top,_#99f6e4_0%,_#f8fafc_35%,_#e2e8f0_100%)] font-display text-finops-900">
			<main class="mx-auto flex min-h-screen max-w-md items-center px-4 py-12">
				<div class="w-full rounded-3xl border border-white/80 bg-white/85 p-8 shadow-2xl shadow-finops-900/15 backdrop-blur-sm">
					<div class="mb-6 flex justify-center">
						<div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-finops-900 text-2xl">
							✉️
						</div>
					</div>
					<p class="text-center text-xs font-bold uppercase tracking-[0.2em] text-finops-500">Falta pouco</p>
					<h1 class="mt-2 text-center text-2xl font-extrabold text-finops-900">Confirme seu e-mail</h1>
					<p class="mt-3 text-center text-sm text-finops-700">
						Enviamos um link para <strong class="text-finops-900">{ email }</strong>.
						Clique no link para ativar sua conta.
					</p>
					if sent {
						<div class="mt-6 rounded-xl bg-teal-50 p-4 text-sm text-teal-800">
							<i class="fa-solid fa-circle-check mr-2 text-teal-500"></i>
							E-mail reenviado. Verifique sua caixa (e o spam).
						</div>
					}
					<form method="post" action="/verify-email/resend" class="mt-6">
						<input type="hidden" name="_csrf" value={ csrf }/>
						<button
							type="submit"
							class="w-full rounded-xl border border-slate-300 bg-white py-3 text-sm font-semibold text-finops-800 transition hover:bg-slate-100"
						>
							Reenviar e-mail de confirmação
						</button>
					</form>
					<form method="post" action="/logout" class="mt-3">
						<input type="hidden" name="_csrf" value={ csrf }/>
						<button
							type="submit"
							class="w-full text-sm text-finops-500 transition hover:text-finops-900 hover:underline"
						>
							Sair
						</button>
					</form>
				</div>
			</main>
		</body>
	</html>
}

templ VerifyEmailResult(success bool, errMsg string) {
	<!DOCTYPE html>
	<html lang="pt-BR">
		@AppHead("Verificação de e-mail · Finops", true)
		<body class="min-h-screen bg-[radial-gradient(circle_at_top,_#99f6e4_0%,_#f8fafc_35%,_#e2e8f0_100%)] font-display text-finops-900">
			<main class="mx-auto flex min-h-screen max-w-md items-center px-4 py-12">
				<div class="w-full rounded-3xl border border-white/80 bg-white/85 p-8 shadow-2xl shadow-finops-900/15 backdrop-blur-sm text-center">
					if success {
						<div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-teal-500 text-2xl text-white">
							<i class="fa-solid fa-check"></i>
						</div>
						<h1 class="text-2xl font-extrabold text-finops-900">E-mail confirmado!</h1>
						<p class="mt-3 text-sm text-finops-700">Sua conta foi ativada com sucesso.</p>
						<a
							href="/"
							class="mt-6 inline-flex items-center justify-center rounded-xl bg-finops-900 px-6 py-3 text-sm font-bold text-white transition hover:bg-finops-800"
						>
							Ir para o Finops
						</a>
					} else {
						<div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-rose-500 text-2xl text-white">
							<i class="fa-solid fa-xmark"></i>
						</div>
						<h1 class="text-2xl font-extrabold text-finops-900">Não foi possível verificar</h1>
						<p class="mt-3 text-sm text-finops-700">{ errMsg }</p>
						<a
							href="/verify-email/pending"
							class="mt-6 inline-flex items-center justify-center rounded-xl bg-finops-900 px-6 py-3 text-sm font-bold text-white transition hover:bg-finops-800"
						>
							Solicitar novo link
						</a>
					}
				</div>
			</main>
		</body>
	</html>
}
