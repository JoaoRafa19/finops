package templates

import (
	"finops/internal/services"
	"finops/internal/store"
	"finops/internal/utils"
	"fmt"
	"time"
)

type TransactionFilters struct {
	Description string
	CategoryID  string
	Direction   string
}

func fmtMonth(t time.Time) string {
	months := [...]string{
		"Jan", "Fev", "Mar", "Abr", "Mai", "Jun",
		"Jul", "Ago", "Set", "Out", "Nov", "Dez",
	}
	return fmt.Sprintf("%s/%d", months[t.Month()-1], t.Year())
}

func fmtDate(t time.Time) string {
	return t.Format("2006-01-02")
}

func spendingBarWidth(total, max float64) string {
	if max == 0 {
		return "0%"
	}
	pct := (total / max) * 100
	if pct > 100 {
		pct = 100
	}
	return fmt.Sprintf("%.0f%%", pct)
}

func maxSpending(rows []service.CategorySpend) float64 {
	var m float64
	for _, r := range rows {
		if r.Total > m {
			m = r.Total
		}
	}
	return m
}

templ ReportsPage(csrf string) {
	<!DOCTYPE html>
	<html lang="pt-BR">
		@AppHead("Relatórios · Finops", true)
		<body class="min-h-screen bg-[linear-gradient(180deg,_#f8fafc_0%,_#e2e8f0_100%)] font-display text-finops-900">
			@SideNav("/reports", csrf)
			<main id="page-content" class="mx-auto max-w-5xl px-4 py-12 pl-16 sm:px-6 sm:pl-16">
				<div class="mb-6">
					<p class="text-xs font-bold uppercase tracking-[0.2em] text-finops-500">Finops</p>
					<h1 class="mt-1 text-3xl font-extrabold">Relatórios</h1>
				</div>
				<div class="rounded-3xl border border-white/80 bg-white/85 p-6 shadow-2xl shadow-finops-900/10 backdrop-blur-sm sm:p-8">
					<!-- Seletor de período -->
					<div class="flex flex-wrap items-end gap-4 border-b border-slate-200 pb-6">
						<div>
							@FormLabel("period", "Período")
							<select
								id="period"
								name="period"
								class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-finops-900 shadow-sm outline-none focus:border-finops-500 focus:ring-2 focus:ring-finops-400/20"
							>
								<option value="1h">Última hora</option>
								<option value="2h">Últimas 2 horas</option>
								<option value="24h">Últimas 24 horas</option>
								<option value="2d">Últimos 2 dias</option>
								<option value="7d">Últimos 7 dias</option>
								<option value="15d">Últimos 15 dias</option>
								<option value="this_month" selected>Este mês</option>
								<option value="30d">Últimos 30 dias</option>
								<option value="custom">Personalizado…</option>
							</select>
						</div>
						<div id="custom-range" class="hidden flex-wrap items-end gap-4">
							<div>
								@FormLabel("from", "De")
								<input
									id="from"
									type="date"
									name="from"
									class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-finops-900 shadow-sm outline-none focus:border-finops-500 focus:ring-2 focus:ring-finops-400/20"
								/>
							</div>
							<div>
								@FormLabel("to", "Até")
								<input
									id="to"
									type="date"
									name="to"
									class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-finops-900 shadow-sm outline-none focus:border-finops-500 focus:ring-2 focus:ring-finops-400/20"
								/>
							</div>
							<button
								type="button"
								id="apply-period"
								class="inline-flex items-center justify-center rounded-xl bg-finops-900 px-4 py-2 text-sm font-bold text-white transition hover:bg-finops-800"
							>Aplicar</button>
						</div>
					</div>
					<!-- Tabs -->
					<div class="mt-6 flex flex-wrap gap-2" id="report-tabs">
						<button type="button" class="report-tab rounded-xl bg-finops-900 px-4 py-2 text-sm font-bold text-white" data-url="/reports/spending">Gastos por Categoria</button>
						<button type="button" class="report-tab rounded-xl border border-slate-300 px-4 py-2 text-sm font-semibold text-finops-800 transition hover:bg-slate-100" data-url="/reports/comparison">Receitas x Despesas</button>
						<button type="button" class="report-tab rounded-xl border border-slate-300 px-4 py-2 text-sm font-semibold text-finops-800 transition hover:bg-slate-100" data-url="/reports/balance">Evolução de Saldo</button>
						<button type="button" class="report-tab rounded-xl border border-slate-300 px-4 py-2 text-sm font-semibold text-finops-800 transition hover:bg-slate-100" data-url="/reports/transactions">Transações</button>
					</div>
					<!-- Conteúdo do relatório -->
					<div id="report-content" class="mt-6">
						<div class="flex items-center justify-center py-12 text-sm text-finops-700">
							<i class="fa-solid fa-spinner fa-spin mr-2"></i> Carregando...
						</div>
					</div>
				</div>
				<!-- Modal de edição de transação -->
				<dialog id="transaction-modal" class="w-full max-w-2xl rounded-2xl border border-slate-300 p-0 shadow-xl backdrop:bg-slate-900/40">
					<div id="transaction-modal-body"></div>
				</dialog>
				<script>
					(function() {
						const TAB_ACTIVE   = "report-tab rounded-xl bg-finops-900 px-4 py-2 text-sm font-bold text-white";
						const TAB_INACTIVE = "report-tab rounded-xl border border-slate-300 px-4 py-2 text-sm font-semibold text-finops-800 transition hover:bg-slate-100";

						let period = { preset: "this_month", from: "", to: "" };

						function buildUrl(base) {
							const p = new URLSearchParams();
							if (period.preset === "custom") {
								if (period.from) p.set("from", period.from);
								if (period.to)   p.set("to",   period.to);
							} else {
								p.set("period", period.preset);
							}
							return p.toString() ? base + "?" + p.toString() : base;
						}

						function loadTab(tab) {
							document.querySelectorAll(".report-tab").forEach(t => t.className = TAB_INACTIVE);
							tab.className = TAB_ACTIVE;
							htmx.ajax("GET", buildUrl(tab.dataset.url), { target: "#report-content", swap: "innerHTML" });
						}

						function reloadActive() {
							const active = document.querySelector(".report-tab.bg-finops-900");
							if (active) loadTab(active);
						}

						function initReports() {
							const tabs = document.querySelectorAll(".report-tab");
							tabs.forEach(tab => tab.addEventListener("click", () => loadTab(tab)));

							const periodSel = document.getElementById("period");
							const customRange = document.getElementById("custom-range");
							periodSel?.addEventListener("change", () => {
								period.preset = periodSel.value;
								if (period.preset === "custom") {
									customRange.classList.remove("hidden");
									customRange.classList.add("flex");
								} else {
									customRange.classList.add("hidden");
									customRange.classList.remove("flex");
									reloadActive();
								}
							});
							document.getElementById("apply-period")?.addEventListener("click", () => {
								period.from = document.getElementById("from").value;
								period.to   = document.getElementById("to").value;
								reloadActive();
							});
							if (tabs.length > 0) loadTab(tabs[0]);
						}

						if (document.readyState === "loading") {
							document.addEventListener("DOMContentLoaded", initReports);
						} else {
							initReports();
						}
					})();
				</script>
			</main>
		</body>
	</html>
}

templ SpendingFragment(rows []service.CategorySpend, from, to time.Time) {
	<div>
		<div class="mb-4 flex items-center justify-between">
			<p class="font-bold text-finops-900">Gastos por Categoria</p>
			<p class="text-sm text-finops-700">{ from.Format("02/01/2006") } – { to.Format("02/01/2006") }</p>
		</div>
		if len(rows) == 0 {
			<p class="py-8 text-center text-sm text-finops-700">Nenhum gasto encontrado no período.</p>
		} else {
			<div class="space-y-3">
				for _, row := range rows {
					<div>
						<div class="mb-1 flex items-center justify-between text-sm">
							<span class="font-semibold text-finops-800">{ row.CategoryName }</span>
							<span class="font-bold text-rose-700">{ utils.FormatMoney(row.Total) }</span>
						</div>
						<div class="h-2 w-full overflow-hidden rounded-full bg-slate-100">
							<div
								class="h-2 rounded-full bg-rose-400"
								style={ fmt.Sprintf("width:%s", spendingBarWidth(row.Total, maxSpending(rows))) }
							></div>
						</div>
					</div>
				}
			</div>
		}
	</div>
}

templ ComparisonFragment(rows []service.MonthlyRow, from, to time.Time) {
	<div>
		<div class="mb-4 flex items-center justify-between">
			<p class="font-bold text-finops-900">Receitas x Despesas</p>
			<p class="text-sm text-finops-700">{ from.Format("02/01/2006") } – { to.Format("02/01/2006") }</p>
		</div>
		if len(rows) == 0 {
			<p class="py-8 text-center text-sm text-finops-700">Nenhum dado encontrado no período.</p>
		} else {
			<div class="overflow-x-auto">
				<table class="w-full text-sm">
					<thead>
						<tr class="border-b border-slate-200 text-left text-xs font-bold uppercase tracking-wide text-finops-500">
							<th class="pb-3 pr-6">Mês</th>
							<th class="pb-3 pr-6 text-right">Receitas</th>
							<th class="pb-3 pr-6 text-right">Despesas</th>
							<th class="pb-3 text-right">Saldo</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-100">
						for _, row := range rows {
							<tr class="py-2">
								<td class="py-3 pr-6 font-semibold text-finops-900">{ fmtMonth(row.Month) }</td>
								<td class="py-3 pr-6 text-right font-bold text-emerald-700">{ utils.FormatMoney(row.Income) }</td>
								<td class="py-3 pr-6 text-right font-bold text-rose-700">{ utils.FormatMoney(row.Expenses) }</td>
								<td class={ comparisonBalanceClass(row.Income - row.Expenses) }>{ utils.FormatMoney(row.Income - row.Expenses) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

func comparisonBalanceClass(diff float64) string {
	base := "py-3 text-right font-bold tabular-nums "
	if diff >= 0 {
		return base + "text-emerald-700"
	}
	return base + "text-rose-700"
}

templ BalanceFragment(points []service.BalancedHistory, from, to time.Time) {
	<div>
		<div class="mb-4 flex items-center justify-between">
			<p class="font-bold text-finops-900">Evolução de Saldo</p>
			<p class="text-sm text-finops-700">{ from.Format("02/01/2006") } – { to.Format("02/01/2006") }</p>
		</div>
		if len(points) == 0 {
			<p class="py-8 text-center text-sm text-finops-700">Nenhum dado encontrado no período.</p>
		} else {
			<div class="overflow-x-auto">
				<table class="w-full text-sm">
					<thead>
						<tr class="border-b border-slate-200 text-left text-xs font-bold uppercase tracking-wide text-finops-500">
							<th class="pb-3 pr-6">Mês</th>
							<th class="pb-3 text-right">Saldo Acumulado</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-100">
						for _, p := range points {
							<tr>
								<td class="py-3 pr-6 font-semibold text-finops-900">{ fmtMonth(p.Month) }</td>
								<td class={ balanceClass(p.Balance) }>{ utils.FormatMoney(p.Balance) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

func balanceClass(balance float64) string {
	base := "py-3 text-right font-bold tabular-nums "
	if balance >= 0 {
		return base + "text-finops-900"
	}
	return base + "text-rose-700"
}

templ TransactionsFragment(items []service.TransactionListItem, categories []store.Category, filters TransactionFilters, page, pageSize int, from, to time.Time) {
	<div>
		<div class="mb-4 flex items-center justify-between">
			<p class="font-bold text-finops-900">Transações</p>
			<p class="text-sm text-finops-700">{ from.Format("02/01/2006") } – { to.Format("02/01/2006") }</p>
		</div>
		<!-- Filtros -->
		<div class="mb-4 flex flex-wrap gap-3">
			<input
				type="text"
				name="description"
				value={ filters.Description }
				placeholder="Buscar por descrição..."
				class="flex-1 min-w-40 rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-finops-900 outline-none focus:border-finops-500 focus:ring-2 focus:ring-finops-400/20"
				hx-get="/reports/transactions"
				hx-trigger="input changed delay:400ms"
				hx-target="#report-content"
				hx-include="[name=from],[name=to],[name=category_id],[name=direction]"
			/>
			<select
				name="category_id"
				class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-finops-900 outline-none focus:border-finops-500"
				hx-get="/reports/transactions"
				hx-trigger="change"
				hx-target="#report-content"
				hx-include="[name=from],[name=to],[name=description],[name=direction]"
			>
				<option value="" selected?={ filters.CategoryID == "" }>Todas as categorias</option>
				for _, cat := range categories {
					<option value={ fmt.Sprintf("%d", cat.ID) } selected?={ fmt.Sprintf("%d", cat.ID) == filters.CategoryID }>{ cat.Name }</option>
				}
			</select>
			<select
				name="direction"
				class="rounded-xl border border-slate-300 bg-white px-3 py-2 text-sm text-finops-900 outline-none focus:border-finops-500"
				hx-get="/reports/transactions"
				hx-trigger="change"
				hx-target="#report-content"
				hx-include="[name=from],[name=to],[name=description],[name=category_id]"
			>
				<option value="" selected?={ filters.Direction == "" }>Todos os tipos</option>
				<option value="debit" selected?={ filters.Direction == "debit" }>Despesa</option>
				<option value="credit" selected?={ filters.Direction == "credit" }>Receita</option>
			</select>
		</div>
		if len(items) == 0 {
			<p class="py-8 text-center text-sm text-finops-700">Nenhuma transação encontrada.</p>
		} else {
			<div class="overflow-x-auto">
				<table class="w-full text-sm">
					<thead>
						<tr class="border-b border-slate-200 text-left text-xs font-bold uppercase tracking-wide text-finops-500">
							<th class="pb-3 pr-4">Data</th>
							<th class="pb-3 pr-4">Descrição</th>
							<th class="pb-3 pr-4">Conta</th>
							<th class="pb-3 pr-4">Categoria</th>
							<th class="pb-3 text-right">Valor</th>
							<th class="pb-3"></th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-100">
						for _, tx := range items {
							<tr id={ fmt.Sprintf("report-tx-%d", tx.ID) }>
								<td class="py-3 pr-4 text-finops-700">{ tx.PostedOn.Format("02/01/06") }</td>
								<td class="py-3 pr-4 font-semibold text-finops-900">{ tx.Description }</td>
								<td class="py-3 pr-4 text-finops-700">{ tx.AccountName }</td>
								<td class="py-3 pr-4 text-finops-700">{ transactionCategoryLabel(tx.Category) }</td>
								<td class={ transactionAmountClass(tx.Direction) }>{ utils.FormatMoney(signedAmount(tx)) }</td>
								<td class="py-3 pl-2">
									<div class="flex items-center gap-1">
										<button
											class="rounded p-1 text-slate-400 transition hover:bg-slate-100 hover:text-finops-700"
											title="Editar"
											hx-get={ fmt.Sprintf("/transactions/%d/edit-modal", tx.ID) }
											hx-target="#transaction-modal-body"
											hx-swap="innerHTML"
											hx-on::after-request="document.getElementById('transaction-modal')?.showModal()"
										><i class="fa-solid fa-pen text-xs"></i></button>
										<button
											class="rounded p-1 text-slate-400 transition hover:bg-rose-50 hover:text-rose-500"
											title="Apagar"
											hx-delete={ fmt.Sprintf("/transactions/%d", tx.ID) }
											hx-target={ fmt.Sprintf("#report-tx-%d", tx.ID) }
											hx-swap="outerHTML"
											hx-confirm="Apagar esta transação?"
										><i class="fa-solid fa-trash text-xs"></i></button>
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<!-- Paginação -->
			<div class="mt-4 flex items-center justify-between">
				if page > 1 {
					<button
						type="button"
						class="inline-flex items-center gap-1 text-sm font-semibold text-finops-700 hover:text-finops-900"
						hx-get={ txPageURL(from, to, page-1, filters) }
						hx-target="#report-content"
						hx-swap="innerHTML"
					><i class="fa-solid fa-chevron-left"></i> Anterior</button>
				} else {
					<span></span>
				}
				<span class="text-sm text-finops-700">Página { fmt.Sprintf("%d", page) }</span>
				if len(items) == pageSize {
					<button
						type="button"
						class="inline-flex items-center gap-1 text-sm font-semibold text-finops-700 hover:text-finops-900"
						hx-get={ txPageURL(from, to, page+1, filters) }
						hx-target="#report-content"
						hx-swap="innerHTML"
					>Próxima <i class="fa-solid fa-chevron-right"></i></button>
				} else {
					<span></span>
				}
			</div>
		}
	</div>
}

func txPageURL(from, to time.Time, page int, f TransactionFilters) string {
	url := fmt.Sprintf("/reports/transactions?from=%s&to=%s&page=%d", fmtDate(from), fmtDate(to), page)
	if f.Description != "" {
		url += "&description=" + f.Description
	}
	if f.CategoryID != "" {
		url += "&category_id=" + f.CategoryID
	}
	if f.Direction != "" {
		url += "&direction=" + f.Direction
	}
	return url
}

func signedAmount(tx service.TransactionListItem) float64 {
	if tx.Direction == "debit" {
		return -tx.Amount
	}
	return tx.Amount
}
