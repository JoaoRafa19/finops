package templates 

import "finops/internal/store"
import "fmt"

templ CategoryPannels(csrf_token string, categories []store.Category, form CategoryFormState) {
	<div
		id="categories-panel"
		if form.Oob {
			hx-swap-oob="outerHTML"
		}
		class="rounded-2xl border border-slate-200 bg-white p-6"
	>
		<span id="error_message">
			if form.ErrorMessage != "" {
				<div class="mb-4 rounded-lg bg-red-100 p-4 text-sm text-red-700">
					{ form.ErrorMessage }
				</div>
			}
		</span>
		<div class="flex items-center justify-between">
			<p class="text-lg font-bold text-finops-900">Categorias</p>
			<p class="mt-01 text-sm text-finops-700">Crie categorias para classificar suas transacoes</p>
		</div>
		if len(categories) > 0 {
			<ul class="mt-6 space-y-3">
				for _, cat := range categories {
					@CategoryRow(cat, csrf_token)
				}
			</ul>
		} else {
			<div class="mt-6 flex flex-col items-start gap-3 rounded-xl border border-dashed border-slate-300 bg-slate-50 p-4">
				<p class="text-sm text-finops-700">Você ainda não tem categorias. Crie a primeira para começar a classificar transações.</p>
				<a href="/" class="inline-flex items-center gap-2 rounded-xl bg-finops-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-finops-800">
					<i class="fa-solid fa-plus" aria-hidden="true"></i> Ir para a home
				</a>
			</div>
		}
	</div>
}

templ CategoryRow(cat store.Category, csrf string) {
	<li id={ fmt.Sprintf("category-%d", cat.ID) } class="flex items-center justify-between rounded-xl border border-slate-200 bg-slate-50 px-4 py-3">
		<div>
			<p class="font-semibold text-finops-900">{ cat.Name }</p>
			<p class="text-sm text-finops-700">{ categoryKindLabel(cat.Kind) }</p>
		</div>
		<div class="flex items-center gap-2">
			<button
				type="button"
				hx-get={ fmt.Sprintf("/categories/%d/edit", cat.ID) }
				hx-target={ fmt.Sprintf("#category-%d", cat.ID) }
				hx-swap="outerHTML"
				class="inline-flex items-center rounded-lg bg-slate-200 px-3 py-1 text-sm text-finops-800 transition hover:bg-slate-300"
				title="Editar categoria"
				aria-label={ "Editar categoria " + cat.Name }
			><i class="fa-solid fa-pen" aria-hidden="true"></i></button>
			<form
				method="post"
				hx-delete={ fmt.Sprintf("/categories/%d/delete", cat.ID) }
				hx-target="closest li"
				hx-swap="outerHTML"
				hx-confirm="Excluir esta categoria?"
			>
				<input type="hidden" name="_csrf" value={ csrf }/>
				<button
					type="submit"
					class="inline-flex items-center rounded-lg bg-red-100 px-3 py-1 text-sm text-red-700 transition hover:bg-red-200"
					title="Excluir categoria"
					aria-label={ "Excluir categoria " + cat.Name }
				><i class="fa-solid fa-trash" aria-hidden="true"></i></button>
			</form>
		</div>
	</li>
}

templ CategoryEditRow(cat store.Category, csrf, errMsg string) {
	<li id={ fmt.Sprintf("category-%d", cat.ID) } class="rounded-xl border border-finops-500 bg-white px-4 py-3">
		<form
			method="post"
			hx-post={ fmt.Sprintf("/categories/%d", cat.ID) }
			hx-target={ fmt.Sprintf("#category-%d", cat.ID) }
			hx-swap="outerHTML"
			class="flex flex-col gap-2 sm:flex-row sm:items-center"
		>
			<input type="hidden" name="_csrf" value={ csrf }/>
			<input
				name="name"
				type="text"
				value={ cat.Name }
				required
				autofocus
				class="flex-1 rounded-lg border border-slate-300 px-3 py-2 text-sm text-finops-900 outline-none focus:border-finops-500"
			/>
			<div class="flex items-center gap-2">
				<button type="submit" class="rounded-lg bg-finops-900 px-3 py-1.5 text-sm font-semibold text-white transition hover:bg-finops-800">Salvar</button>
				<button
					type="button"
					hx-get={ fmt.Sprintf("/categories/%d/row", cat.ID) }
					hx-target={ fmt.Sprintf("#category-%d", cat.ID) }
					hx-swap="outerHTML"
					class="rounded-lg bg-slate-200 px-3 py-1.5 text-sm text-finops-800 transition hover:bg-slate-300"
				>Cancelar</button>
			</div>
		</form>
		if errMsg != "" {
			<p class="mt-2 text-sm text-red-700">{ errMsg }</p>
		}
	</li>
}

templ CategoryModalDialog(form CategoryFormState, csrf_token string) {
	<div class="p-6" id="category-modal-body">
		<div class="flex items-center justify-between">
			<p class="text-lg font-bold text-finops-900">Cadastrar nova categoria</p>
			<form method="dialog">
				<button
					type="submit"
					class="inline-flex size-9 items-center justify-center rounded-lg bg-slate-200 text-finops-500 transition hover:bg-slate-300"
					title="Fechar modal"
				><i class="fa-solid fa-xmark"></i></button>
			</form>
		</div>
		<p class="mt-2 text-sm text-finops-700">Crie categorias para classificar suas transacoes</p>
		@CategoryForm(form, csrf_token)
	</div>
}

templ CategoryForm(form CategoryFormState, csrf_token string) {
	<form
		method="post"
		action="/categories"
		hx-post="/categories"
		hx-target="#category-modal-body"
		hx-swap="innerHTML"
		class="mt-6 grid gap-4 md:grid-cols-2"
	>
		<input type="hidden" name="_csrf" value={ csrf_token }/>
		if form.ErrorMessage != "" {
			<div class="col-span-full rounded-lg bg-red-100 p-4 text-sm text-red-700">
				{ form.ErrorMessage }
			</div>
		}
		<div>
			@FormLabel("name", "Nome da Categoria")
			@TextInput("name", "name", "text", form.Name, "Ex: Alimentacao, Salario, etc", true)
		</div>
		<div>
			@FormLabel("category_kind", "Tipo")
			@SelectInput("category_kind", "category_kind", buildCategoryKindOptions(form.Kind), true)
		</div>
		<div class="md:col-span-2 flex flex-col gap-3 sm:flex-row">
			@PrimaryButton("submit", "Criar Categoria", true)
		</div>
	</form>
}
