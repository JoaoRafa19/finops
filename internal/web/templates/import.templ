	<div>
		<div class="mb-4 flex items-center justify-between">
			<p class="font-bold text-finops-900">{ fmt.Sprintf("%d transações encontradas", len(rows)) }</p>
			<p class="text-sm text-finops-700">Revise antes de confirmar</p>
		</div>
		<div class="max-h-72 overflow-y-auto rounded-xl border border-slate-200">
			<table class="w-full text-sm">
				<thead class="sticky top-0 bg-slate-50">
					<tr class="border-b border-slate-200 text-left text-xs font-bold uppercase tracking-wide text-finops-500">
						<th class="px-4 py-2">Data</th>
						<th class="px-4 py-2">Descrição</th>
						<th class="px-4 py-2 text-right">Valor</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-slate-100">
					for _, row := range rows {
						<tr>
							<td class="px-4 py-2 text-finops-700">{ row.PostedOn.Format("02/01/2006") }</td>
							<td class="px-4 py-2 text-finops-900">{ row.Description }</td>
							<td class={ "px-4 py-2 text-right font-bold tabular-nums " + importAmountClass(row.Direction) }>
								{ importAmountLabel(row) }
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<form
			hx-post="/import/confirm"
			hx-target="#import-result"
			hx-swap="innerHTML"
			class="mt-4"
		>
			<input type="hidden" name="_csrf" value={ csrf }/>
			<input type="hidden" name="uuid" value={ uuid }/>
			<input type="hidden" name="account_id" value={ accountID }/>
			@PrimaryButton("submit", fmt.Sprintf("Confirmar importação de %d transações", len(rows)), true)
		</form>
	</div>
}

templ ImportResultFragment(result service.ImportResult) {
	<div class="rounded-xl border border-slate-200 bg-slate-50 p-6 text-center">
		<i class="fa-solid fa-circle-check mb-3 text-3xl text-emerald-500"></i>
		<p class="text-lg font-bold text-finops-900">Importação concluída</p>
		<div class="mt-4 flex justify-center gap-8 text-sm">
			<div>
				<p class="text-2xl font-extrabold text-emerald-700">{ fmt.Sprintf("%d", result.Inserted) }</p>
				<p class="text-finops-700">inseridas</p>
			</div>
			<div>
				<p class="text-2xl font-extrabold text-slate-500">{ fmt.Sprintf("%d", result.Duplicates) }</p>
				<p class="text-finops-700">duplicadas</p>
			</div>
			if result.Errors > 0 {
				<div>
					<p class="text-2xl font-extrabold text-rose-600">{ fmt.Sprintf("%d", result.Errors) }</p>
					<p class="text-finops-700">erros</p>
				</div>
			}
		</div>
		<a href="/" class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-finops-700 underline decoration-finops-400/70 underline-offset-4 hover:text-finops-900">
			Ver transações na home
		</a>
	</div>
}

func importAmountClass(direction string) string {
	if direction == "credit" {
		return "text-emerald-700"
	}
	return "text-rose-700"
}

func importAmountLabel(row service.ImportRow) string {
	if row.Direction == "debit" {
		return utils.FormatMoney(-row.Amount)
	}
	return utils.FormatMoney(row.Amount)
}

func buildColOptions(headers []string, selected int) []SelectOption {
	opts := []SelectOption{{Value: "-1", Label: "— não usar —", Selected: selected == -1}}
	for i, h := range headers {
		opts = append(opts, SelectOption{
			Value:    fmt.Sprintf("%d", i),
			Label:    fmt.Sprintf("[%d] %s", i, h),
			Selected: i == selected,
		})
	}
	return opts
}
