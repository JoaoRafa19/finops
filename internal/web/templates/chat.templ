package templates

import service "finops/internal/services"

templ ChatWidget(csrf string) {
	<div id="chat-widget" class="fixed bottom-6 right-6 z-50 flex flex-col items-end gap-3">
		<!-- Painel -->
		<div
			id="chat-panel"
			class="relative hidden flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl shadow-finops-900/20"
			style="width:320px; height:480px; min-width:260px; min-height:340px;"
		>
			<!-- Handle de redimensionamento -->
			<div
				id="chat-resize-handle"
				class="absolute left-0 top-0 z-10 flex h-5 w-5 cursor-nw-resize items-center justify-center"
				title="Redimensionar"
			>
				<svg class="h-3 w-3 text-slate-400 opacity-60" viewBox="0 0 16 16" fill="none">
					<path d="M2 14L14 2M2 9L9 2M2 4L4 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
				</svg>
			</div>
			<!-- Cabeçalho -->
			<div class="flex shrink-0 items-center justify-between bg-finops-900 px-4 py-3">
				<div class="flex items-center gap-2">
					<i class="fa-solid fa-robot text-finops-400"></i>
					<span class="text-sm font-bold text-white">Assistente Finops</span>
				</div>
				<button
					onclick="chatToggle()"
					class="text-white/60 transition hover:text-white"
					title="Fechar"
				><i class="fa-solid fa-xmark"></i></button>
			</div>
			<!-- Mensagens -->
			<div
				id="chat-messages"
				class="flex min-h-0 flex-1 flex-col gap-3 overflow-y-auto p-4"
				hx-get="/chat/history"
				hx-trigger="click from:#chat-open-btn once"
				hx-swap="innerHTML"
				hx-on::after-settle="this.scrollTop = this.scrollHeight; chatRenderMarkdown();"
			>
				<div class="flex flex-col items-center justify-center gap-2 py-8 text-center">
					<i class="fa-solid fa-comments text-2xl text-finops-400"></i>
					<p class="text-xs text-finops-700">Olá! Pergunte sobre suas finanças.</p>
				</div>
			</div>
			<!-- Indicador de carregamento -->
			<div id="chat-loading" class="htmx-indicator shrink-0 px-4 pb-1">
				<div class="flex items-center gap-2 text-xs text-finops-500">
					<i class="fa-solid fa-spinner fa-spin"></i>
					<span>Processando...</span>
				</div>
			</div>
			<!-- Input -->
			<div class="shrink-0 border-t border-slate-200 p-3">
				<form
					hx-post="/chat"
					hx-target="#chat-messages"
					hx-swap="beforeend"
					hx-indicator="#chat-loading"
					hx-on::after-request="const m=document.getElementById('chat-messages'); m.scrollTop=m.scrollHeight; chatRenderMarkdown(); document.getElementById('chat-input').value=''; document.getElementById('chat-input').focus();"
				>
					<input type="hidden" name="_csrf" value={ csrf }/>
					<div class="flex gap-2">
						<input
							id="chat-input"
							name="message"
							type="text"
							placeholder="Pergunte sobre suas finanças..."
							autocomplete="off"
							class="flex-1 rounded-xl border border-slate-300 px-3 py-2 text-sm text-finops-900 outline-none focus:border-finops-500 focus:ring-2 focus:ring-finops-400/20"
						/>
						<button
							type="submit"
							class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-finops-900 text-white transition hover:bg-finops-800"
						>
							<i class="fa-solid fa-paper-plane text-xs"></i>
						</button>
					</div>
				</form>
			</div>
		</div>
		<!-- Botão de abrir/fechar -->
		<button
			id="chat-open-btn"
			onclick="chatToggle()"
			class="flex h-12 w-12 items-center justify-center rounded-full bg-finops-900 text-white shadow-lg transition hover:bg-finops-800"
			title="Assistente financeiro"
		>
			<i class="fa-solid fa-comments"></i>
		</button>
	</div>
	<style>
		.chat-md p { margin: 0.25rem 0; }
		.chat-md ul, .chat-md ol { margin: 0.25rem 0 0.25rem 1rem; }
		.chat-md li { margin: 0.1rem 0; }
		.chat-md strong { font-weight: 700; }
		.chat-md em { font-style: italic; }
		.chat-md code { background: #e2e8f0; border-radius: 3px; padding: 0 3px; font-size: 0.8em; }
		.chat-md pre { background: #e2e8f0; border-radius: 6px; padding: 6px 8px; overflow-x: auto; margin: 0.25rem 0; }
		.chat-md pre code { background: none; padding: 0; }
		.chat-md h1,.chat-md h2,.chat-md h3,.chat-md h4 { font-weight: 700; margin: 0.4rem 0 0.1rem; }
	</style>
	<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
	<script>
		function chatToggle() {
			const p = document.getElementById("chat-panel");
			if (p.classList.contains("hidden")) {
				p.classList.remove("hidden");
				p.classList.add("flex");
			} else {
				p.classList.remove("flex");
				p.classList.add("hidden");
			}
		}

		(function() {
			const STORAGE_KEY = "finops_chat_size";
			const panel = document.getElementById("chat-panel");
			const handle = document.getElementById("chat-resize-handle");

			// Restaurar tamanho salvo
			try {
				const saved = JSON.parse(localStorage.getItem(STORAGE_KEY));
				if (saved) {
					panel.style.width  = saved.w + "px";
					panel.style.height = saved.h + "px";
				}
			} catch (_) {}

			let startX, startY, startW, startH;

			handle.addEventListener("mousedown", function(e) {
				e.preventDefault();
				startX = e.clientX;
				startY = e.clientY;
				startW = panel.offsetWidth;
				startH = panel.offsetHeight;

				function onMove(e) {
					const newW = Math.max(260, startW - (e.clientX - startX));
					const newH = Math.max(340, startH - (e.clientY - startY));
					panel.style.width  = newW + "px";
					panel.style.height = newH + "px";
				}

				function onUp() {
					document.removeEventListener("mousemove", onMove);
					document.removeEventListener("mouseup", onUp);
					try {
						localStorage.setItem(STORAGE_KEY, JSON.stringify({
							w: panel.offsetWidth,
							h: panel.offsetHeight
						}));
					} catch (_) {}
				}

				document.addEventListener("mousemove", onMove);
				document.addEventListener("mouseup", onUp);
			});
		})();

		function chatRenderMarkdown() {
			document.querySelectorAll(".chat-md:not([data-rendered])").forEach(el => {
				el.innerHTML = marked.parse(el.textContent || "");
				el.dataset.rendered = "1";
			});
		}
	</script>
}

templ ChatMessagePair(question, answer string) {
	@chatUserBubble(question)
	@chatAssistantBubble(answer)
}

templ ChatHistoryFragment(messages []service.ChatMessage) {
	if len(messages) == 0 {
		<div class="flex flex-col items-center justify-center gap-2 py-8 text-center">
			<i class="fa-solid fa-comments text-2xl text-finops-400"></i>
			<p class="text-xs text-finops-700">Olá! Pergunte sobre suas finanças.</p>
		</div>
	} else {
		for _, msg := range messages {
			if msg.Role == "user" {
				@chatUserBubble(msg.Content)
			} else {
				@chatAssistantBubble(msg.Content)
			}
		}
	}
}

templ ChatErrorBubble(errMsg string) {
	@chatAssistantBubble(errMsg)
}

templ chatUserBubble(content string) {
	<div class="flex justify-end">
		<div class="max-w-[85%] rounded-2xl rounded-tr-sm bg-finops-900 px-3 py-2 text-sm text-white">
			{ content }
		</div>
	</div>
}

templ chatAssistantBubble(content string) {
	<div class="flex justify-start">
		<div class="chat-md prose prose-sm max-w-[85%] rounded-2xl rounded-tl-sm bg-slate-100 px-3 py-2 text-sm text-finops-900">
			{ content }
		</div>
	</div>
}
