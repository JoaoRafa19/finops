package templates

import (
	"fmt"

	service "finops/internal/services"
)

templ ChatWidget(csrf string) {
	<div id="chat-widget" class="fixed bottom-6 right-6 z-50 flex flex-col items-end gap-3">
		<!-- Painel -->
		<div
			id="chat-panel"
			class="relative hidden flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl shadow-finops-900/20"
			style="width:min(320px, calc(100vw - 5rem)); height:min(480px, calc(100vh - 7rem)); min-width:220px; min-height:280px;"
		>
			<!-- Handle de redimensionamento -->
			<div
				id="chat-resize-handle"
				class="absolute left-0 top-0 z-10 flex h-5 w-5 cursor-nw-resize items-center justify-center"
				title="Redimensionar"
			>
				<svg class="h-3 w-3 text-slate-400 opacity-60" viewBox="0 0 16 16" fill="none">
					<path d="M2 14L14 2M2 9L9 2M2 4L4 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
				</svg>
			</div>
			<!-- Cabeçalho -->
			<div class="flex shrink-0 items-center justify-between bg-finops-900 px-4 py-3">
				<div class="flex items-center gap-2">
					<i class="fa-solid fa-robot text-finops-400"></i>
					<span class="text-sm font-bold text-white">Assistente Finops</span>
					<button
						type="button"
						onclick="document.getElementById('chat-tips-modal')?.showModal()"
						class="text-white/60 transition hover:text-white"
						title="Dicas de uso do assistente"
						aria-label="Dicas de uso do assistente"
					><i class="fa-solid fa-circle-info text-xs" aria-hidden="true"></i></button>
				</div>
				<div class="flex items-center gap-3">
					<button
						type="button"
						hx-post="/chat/clear"
						hx-target="#chat-messages"
						hx-swap="innerHTML"
						hx-confirm="Limpar toda a conversa?"
						hx-vals={ fmt.Sprintf(`{"_csrf":"%s"}`, csrf) }
						class="text-white/60 transition hover:text-white"
						title="Limpar conversa"
						aria-label="Limpar conversa"
					><i class="fa-solid fa-trash-can text-xs" aria-hidden="true"></i></button>
					<button
						onclick="chatToggle()"
						class="text-white/60 transition hover:text-white"
						title="Fechar chat"
						aria-label="Fechar chat"
					><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
				</div>
			</div>
			@ChatTipsModal()
			<!-- Mensagens -->
			<div
				id="chat-messages"
				class="flex min-h-0 flex-1 flex-col gap-3 overflow-y-auto p-4"
				hx-get="/chat/history"
				hx-trigger="click from:#chat-open-btn once"
				hx-swap="innerHTML"
				hx-on::after-settle="this.scrollTop = this.scrollHeight; chatRenderMarkdown();"
			>
				@ChatEmptyState()
			</div>
			<!-- Indicador de carregamento -->
			<div id="chat-loading" class="htmx-indicator shrink-0 px-4 pb-1">
				<div class="flex items-center gap-2 text-xs text-finops-500">
					<i class="fa-solid fa-spinner fa-spin"></i>
					<span>Processando...</span>
				</div>
			</div>
			<!-- Input -->
			<div class="shrink-0 border-t border-slate-200 p-3">
				<form
					hx-post="/chat"
					hx-target="#chat-messages"
					hx-swap="beforeend"
					hx-indicator="#chat-loading"
					hx-on::after-request="const m=document.getElementById('chat-messages'); m.scrollTop=m.scrollHeight; chatRenderMarkdown(); document.getElementById('chat-input').value=''; document.getElementById('chat-input').focus();"
				>
					<input type="hidden" name="_csrf" value={ csrf }/>
					<div class="flex gap-2">
						<input
							id="chat-input"
							name="message"
							type="text"
							placeholder="Pergunte sobre suas finanças..."
							autocomplete="off"
							class="flex-1 rounded-xl border border-slate-300 px-3 py-2 text-sm text-finops-900 outline-none focus:border-finops-500 focus:ring-2 focus:ring-finops-400/20"
						/>
						<button
							type="submit"
							class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-finops-900 text-white transition hover:bg-finops-800"
						>
							<i class="fa-solid fa-paper-plane text-xs"></i>
						</button>
					</div>
				</form>
			</div>
		</div>
		<!-- Botão de abrir/fechar -->
		<button
			id="chat-open-btn"
			onclick="chatToggle()"
			class="flex h-12 w-12 items-center justify-center rounded-full bg-finops-900 text-white shadow-lg transition hover:bg-finops-800"
			title="Abrir assistente financeiro"
			aria-label="Abrir assistente financeiro"
		>
			<i class="fa-solid fa-comments" aria-hidden="true"></i>
		</button>
	</div>
	<style>
		#chat-messages { font-size: var(--chat-font, 13px); line-height: 1.45; }
		.chat-md p { margin: 0.25rem 0; }
		.chat-md ul, .chat-md ol { margin: 0.25rem 0 0.25rem 1rem; }
		.chat-md li { margin: 0.1rem 0; }
		.chat-md strong { font-weight: 700; }
		.chat-md em { font-style: italic; }
		.chat-md code { background: #e2e8f0; border-radius: 3px; padding: 0 3px; font-size: 0.85em; }
		.chat-md pre { background: #e2e8f0; border-radius: 6px; padding: 6px 8px; overflow-x: auto; margin: 0.25rem 0; }
		.chat-md pre code { background: none; padding: 0; }
		.chat-md h1,.chat-md h2,.chat-md h3,.chat-md h4 { font-weight: 700; margin: 0.4rem 0 0.1rem; }
	</style>
	<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
	<script>
		function chatToggle() {
			const p = document.getElementById("chat-panel");
			if (p.classList.contains("hidden")) {
				p.classList.remove("hidden");
				p.classList.add("flex");
			} else {
				p.classList.remove("flex");
				p.classList.add("hidden");
			}
		}

		// Aplica tamanho de fonte do chat (persistido em localStorage).
		function applyChatFont() {
			const size = localStorage.getItem("finops_chat_font") || "13";
			document.documentElement.style.setProperty("--chat-font", size + "px");
		}
		window.setChatFont = function(size) {
			localStorage.setItem("finops_chat_font", String(size));
			applyChatFont();
		};
		applyChatFont();

		(function() {
			const STORAGE_KEY = "finops_chat_size";
			const panel = document.getElementById("chat-panel");
			const handle = document.getElementById("chat-resize-handle");

			// Restaurar tamanho salvo, clampeando ao viewport atual.
			try {
				const saved = JSON.parse(localStorage.getItem(STORAGE_KEY));
				if (saved) {
					const maxW = window.innerWidth  - 80;
					const maxH = window.innerHeight - 112;
					panel.style.width  = Math.min(saved.w, maxW) + "px";
					panel.style.height = Math.min(saved.h, maxH) + "px";
				}
			} catch (_) {}

			let startX, startY, startW, startH;

			handle.addEventListener("mousedown", function(e) {
				e.preventDefault();
				startX = e.clientX;
				startY = e.clientY;
				startW = panel.offsetWidth;
				startH = panel.offsetHeight;

				function onMove(e) {
					const newW = Math.max(260, startW - (e.clientX - startX));
					const newH = Math.max(340, startH - (e.clientY - startY));
					panel.style.width  = newW + "px";
					panel.style.height = newH + "px";
				}

				function onUp() {
					document.removeEventListener("mousemove", onMove);
					document.removeEventListener("mouseup", onUp);
					try {
						localStorage.setItem(STORAGE_KEY, JSON.stringify({
							w: panel.offsetWidth,
							h: panel.offsetHeight
						}));
					} catch (_) {}
				}

				document.addEventListener("mousemove", onMove);
				document.addEventListener("mouseup", onUp);
			});
		})();

		function chatRenderMarkdown() {
			document.querySelectorAll(".chat-md:not([data-rendered])").forEach(el => {
				el.innerHTML = marked.parse(el.textContent || "");
				el.dataset.rendered = "1";
			});
		}
	</script>
}

templ ChatMessagePair(question, answer string) {
	@chatUserBubble(question)
	@chatAssistantBubble(answer)
}

templ ChatEmptyState() {
	<div class="flex flex-col items-center justify-center gap-2 py-8 text-center">
		<i class="fa-solid fa-comments text-2xl text-finops-400"></i>
		<p class="text-xs text-finops-700">Olá! Pergunte sobre suas finanças.</p>
	</div>
}

templ ChatHistoryFragment(messages []service.ChatMessage) {
	if len(messages) == 0 {
		@ChatEmptyState()
	} else {
		for _, msg := range messages {
			if msg.Role == "user" {
				@chatUserBubble(msg.Content)
			} else {
				@chatAssistantBubble(msg.Content)
			}
		}
	}
}

templ ChatErrorBubble(errMsg string) {
	@chatAssistantBubble(errMsg)
}

// ChatErrorPair mantém a pergunta do usuário visível quando a resposta falha,
// para a mensagem não "se perder" após o input ser limpo.
templ ChatErrorPair(question, errMsg string) {
	@chatUserBubble(question)
	@chatAssistantBubble(errMsg)
}

templ chatUserBubble(content string) {
	<div class="flex justify-end">
		<div class="max-w-[85%] rounded-2xl rounded-tr-sm bg-finops-900 px-3 py-2 text-white">
			{ content }
		</div>
	</div>
}

templ chatAssistantBubble(content string) {
	<div class="flex justify-start">
		<div class="chat-md prose prose-sm max-w-[85%] rounded-2xl rounded-tl-sm bg-slate-100 px-3 py-2 text-finops-900">
			{ content }
		</div>
	</div>
}

templ ChatTipsModal() {
	<dialog id="chat-tips-modal" class="w-[calc(100vw-1.5rem)] max-w-lg rounded-2xl border border-slate-300 p-0 shadow-xl backdrop:bg-slate-900/40">
		<div class="p-6">
			<div class="flex items-start justify-between gap-4">
				<div>
					<p class="text-xs font-bold uppercase tracking-[0.2em] text-finops-500">Assistente Finops</p>
					<h2 class="mt-1 text-lg font-bold text-finops-900">Como aproveitar melhor</h2>
				</div>
				<form method="dialog">
					@DefaultCloseModalButton()
				</form>
			</div>
			<p class="mt-2 text-sm text-finops-700">Exemplos de perguntas que ajudam a obter respostas mais úteis.</p>
			<div class="mt-5 space-y-4">
				@chatTipSection("📊 Análise financeira", []string{
					"Como posso economizar mais este mês?",
					"Em quais categorias estou gastando mais?",
					"Compare meus gastos deste mês com o anterior.",
				})
				@chatTipSection("🎯 Planejamento", []string{
					"Quanto posso gastar com lazer este mês?",
					"Estou dentro do meu orçamento?",
				})
				@chatTipSection("💡 Insights", []string{
					"Existe alguma despesa incomum?",
					"Quais assinaturas eu poderia cancelar?",
					"Onde consigo reduzir meus gastos?",
				})
				@chatTipSection("📈 Investimentos", []string{
					"Quanto consegui economizar nos últimos meses?",
					"Qual foi minha média de economia?",
				})
			</div>
		</div>
	</dialog>
}

templ chatTipSection(title string, examples []string) {
	<div>
		<p class="text-sm font-bold text-finops-900">{ title }</p>
		<ul class="mt-2 space-y-1.5">
			for _, ex := range examples {
				<li class="flex items-start gap-2 rounded-lg bg-slate-50 px-3 py-2 text-sm text-finops-800">
					<i class="fa-solid fa-quote-left mt-1 text-xs text-finops-400"></i>
					<span>{ ex }</span>
				</li>
			}
		</ul>
	</div>
}

templ ChatPreferencesPanel() {
	<section class="rounded-2xl border border-slate-200 bg-white p-6">
		<h2 class="mb-1 text-sm font-bold uppercase tracking-wide text-finops-500">Assistente Finops</h2>
		<p class="mb-4 text-sm text-finops-700">Tamanho da fonte no chat.</p>
		<div class="flex flex-wrap gap-2" id="chat-font-choices">
			<button type="button" data-size="12" class="rounded-xl border border-slate-300 px-4 py-2 text-xs font-semibold text-finops-800 transition hover:bg-slate-100">Pequeno</button>
			<button type="button" data-size="13" class="rounded-xl border border-slate-300 px-4 py-2 text-sm font-semibold text-finops-800 transition hover:bg-slate-100">Médio</button>
			<button type="button" data-size="15" class="rounded-xl border border-slate-300 px-4 py-2 text-base font-semibold text-finops-800 transition hover:bg-slate-100">Grande</button>
		</div>
		<script>
			(function() {
				const ACTIVE = "bg-finops-900 text-white border-finops-900";
				const root = document.getElementById("chat-font-choices");
				if (!root) return;
				const current = localStorage.getItem("finops_chat_font") || "13";
				function paint(size) {
					root.querySelectorAll("button").forEach(b => {
						const on = b.dataset.size === String(size);
						ACTIVE.split(" ").forEach(c => b.classList.toggle(c, on));
					});
				}
				paint(current);
				root.querySelectorAll("button").forEach(b => {
					b.addEventListener("click", () => {
						window.setChatFont?.(b.dataset.size);
						paint(b.dataset.size);
					});
				});
			})();
		</script>
	</section>
}
