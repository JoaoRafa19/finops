package templates

import "finops/internal/store"

templ HomePage(user, csrf_token string, accounts []store.Account) {
	<!DOCTYPE html>
	<html lang="pt-BR">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
			<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;700;800&display=swap" rel="stylesheet"/>
			<script src="https://cdn.tailwindcss.com"></script>
			<script>                                                        
                                tailwind.config = {                                     
                                        theme: {                                        
                                                extend: {                               
                                                        fontFamily: {                   
                                                                display: ["Manrope", "sans-serif"],                                                                             
                                                        },                              
                                                        colors: {                       
                                                                finops: {               
                                                                        900: "#0f172a", 
                                                                        800: "#1e293b", 
                                                                        700: "#334155", 
                                                                        500: "#0ea5a4", 
                                                                        400: "#2dd4bf", 
                                                                },                      
                                                        },                              
                                                },                                      
                                        },                                              
                                }                                                       
                        </script>
			<title>Finops</title>
		</head>
		<body class="min-h-screen bg-[linear-gradient(180deg,_#f8fafc_0%,_#e2e8f0_100%)] font-display text-finops-900">
			<main class="mx-auto flex min-h-screen max-w-5xl items-center px-4 py-12 sm:px-6">
				<section class="w-full rounded-3xl border border-white/80 bg-white/85 p-8 shadow-2xl shadow-finops-900/10 backdrop-blur-sm sm:p-10">
					<p class="text-xs font-bold uppercase tracking-[0.2em] text-finops-500">Workspace</p>
					<h1 class="mt-3 text-3xl font-extrabold sm:text-4xl">Finops online</h1>
					<p class="mt-3 text-sm text-finops-700">
						Você está autenticado como              
						<span class="font-bold text-finops-900">{ user }</span>.                                                                        
					</p>
					<div class="mt-8 rounded-2xl border border-slate-200 bg-slate-50 p-5">
						<p class="text-sm font-semibold text-finops-800">Sessão ativa e protegida por CSRF.</p>
						<p class="mt-1 text-sm text-finops-700">Seu workspace já está pronto. O próximo passo é cadastrar sua primeira conta.</p>
					</div>
					<div class="mt-8">
						if len(accounts) == 0 {
							<div class="rounded-2xl border border-dashed border-slate-300 bg-white p-6">
								<p class="text-lg font-bold text-finops-900">Nenhuma conta cadastrada</p>
								<p class="mt-2 text-sm text-finops-700">
									Cadastre sua primeira conta para começar a registrar transações e acompanhar seus saldos.                                                                               
								</p>
								<form method="post" action="/accounts" class="mt-6 grid gap-4 md:grid-cols-2">
									<input type="hidden" name="_csrf" value={ csrf_token }/>
									<div class="md:col-span-2">
										<label for="name" class="mb-2 block text-sm font-bold text-finops-800">Nome da conta</label>
										<input
											id="name"
											type="text"
											name="name"
											placeholder="Conta corrente principal"
											required
											class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-finops-900 shadow-sm outline-none transition focus:border-finops-500 focus:ring-4 focus:ring-finops-400/20"
										/>
									</div>
									<div>
										<label for="type" class="mb-2 block text-sm font-bold text-finops-800">Tipo</label>
										<select
											id="type"
											name="type"
											required
											class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-finops-900 shadow-sm outline-none transition focus:border-finops-500 focus:ring-4 focus:ring-finops-400/20"
										>
											<option value="">Selecione</option>
											<option value="checking">Conta corrente</option>
											<option value="savings">Poupança</option>
											<option value="cash">Dinheiro</option>
											<option value="credit_card">Cartão</option>
											<option value="investment">Investimento</option>
										</select>
									</div>
									<div>
										<label for="currency" class="mb-2 block text-sm font-bold text-finops-800">Moeda</label>
										<input
											id="currency"
											type="text"
											name="currency"
											value="BRL"
											required
											class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-finops-900 shadow-sm outline-none transition focus:border-finops-500 focus:ring-4 focus:ring-finops-400/20"
										/>
									</div>
									<div>
										<label for="opening_balance" class="mb-2 block text-sm font-bold text-finops-800">Saldo inicial</label>
										<input
											id="opening_balance"
											type="text"
											name="opening_balance"
											placeholder="0.00"
											required
											class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-finops-900 shadow-sm outline-none transition focus:border-finops-500 focus:ring-4 focus:ring-finops-400/20"
										/>
									</div>
									<div>
										<label for="opening_date" class="mb-2 block text-sm font-bold text-finops-800">Data inicial</label>
										<input
											id="opening_date"
											type="date"
											name="opening_date"
											class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-finops-900      
  shadow-sm outline-none transition focus:border-finops-500 focus:ring-4 focus:ring-finops-400/20"
										/>
									</div>
									<div class="md:col-span-2">
										<button
											type="submit"
											class="inline-flex w-full items-center justify-center rounded-xl bg-finops-900 px-4 py-3 text-sm font-extrabold uppercase tracking-[0.16em] text-white shadow-lg shadow-finops-900/20 transition hover:bg-finops-800 focus:outline-none focus:ring-4 focus:ring-finops-400/25"
										>
											Cadastrar primeira conta                                                                 
										</button>
									</div>
								</form>
							</div>
						} else {
							<div class="rounded-2xl border border-slate-200 bg-white p-6">
								<div class="flex items-center justify-between">
									<div>
										<p class="text-lg font-bold text-finops-900">Contas cadastradas</p>
										<p class="mt-1 text-sm text-finops-700">
											Base inicial pronta para lançamentos e                  
											transferências.
										</p>
									</div>
								</div>
								<ul class="mt-6 space-y-3">
									for _, ac := range accounts {
										<li
											class="flex items-center justify-between rounded-xl border border-slate-200 bg-             
  slate-50 px-4 py-3"
										>
											<div>
												<p class="font-semibold text-finops-900">{ ac.Name }</p>
												<p class="text-sm text-finops-700">{ ac.Type } • { ac.Currency }</p>
											</div>
											<p class="text-sm font-bold text-finops-800">{ ac.OpeningBalance }</p>
										</li>
									}
								</ul>
							</div>
						}
					</div>
					<form method="post" action="/logout" class="mt-8">
						<input type="hidden" name="_csrf" value={ csrf_token }/>
						<button
							type="submit"
							class="inline-flex items-center justify-center rounded-xl bg-finops-900 px-5 py-3                                       
  text-sm font-extrabold uppercase tracking-[0.16em] text-white shadow-lg shadow-finops-
  900/20 transition hover:bg-finops-800 focus:outline-none focus:ring-4 focus:ring-finops-400/25"
						>
							Sair                            
						</button>
					</form>
				</section>
			</main>
		</body>
	</html>
}
