package templates 

import (
	"finops/internal/store"
	"finops/internal/utils"
	"fmt"
)

templ AccountEditForm(form AccountFormState, csrfToken string) {
	<li class="rounded-xl border border-slate-200 bg-slate-50 px-4 py-4" id={ form.ContainerID() }>
		@AccountForm(form, csrfToken)
	</li>
}

templ AccountPanels(csrf_token string, accounts []store.Account, form AccountFormState) {
	<div id="accounts-panel" class="rounded-2x1 border border-slate-200 bg-white p-6">
		if len(accounts) == 0 {
			<p class="text-lg font-bold text-finops-900">{ accountFormTitle(form) }</p>
			<p class="mt-2 text-sm text-finops-700">{ accountFormDescription(form) }</p>
			@AccountForm(form, csrf_token)
		} else {
			<div class="flex items-center justify-between">
				<p class="text-lg font-bold text-finops-900">Contas Cadastradas</p>
				<p class="mt-01 text-sm text-finops-700">Base inicial pronta para lançamentos e transferências</p>
			</div>
			<ul class="mt-6 space-y-3" id="accounts-list">
				for _, ac := range accounts {
					@AccountItem(ac)
				}
			</ul>
		}
	</div>
}

templ AccountItem(account store.Account) {
	<li id={ fmt.Sprintf("account-%d", account.ID) } class="flex items-center justify-between rounded-xl border border-slate-200 bg-slate-50 px-4 py-3">
		<div>
			<p class="font-semibold text-finops-900">{ account.Name }</p>
			<p class="text-sm text-finops-700">{ account.Type } • { account.Currency }</p>
		</div>
		<div class="flex items-center gap-3">
			<p class="text-sm font-bold text-finops-800">{ utils.FormatMoney(account.OpeningBalance) }</p>
			<button
				type="button"
				hx-get={ fmt.Sprintf("/accounts/%d/edit", account.ID) }
				hx-target="closest li"
				hx-swap="outerHTML"
				class="inline-flex size-9 items-center justify-center rounded-lg bg-slate-200 text-finops-500 transition hover:bg-slate-300"
				title="Editar conta"
			><i class="fa-solid fa-pen-to-square"></i></button>
		</div>
	</li>
}

templ AccountForm(form AccountFormState, csrf_token string) {
	<form
		method="post"
		action={ accountFormAction(form) }
		hx-post={ accountFormAction(form) }
		hx-target={ accountFormTarget(form) }
		hx-swap="outerHTML"
		class={ accountFormClass(form.Inline) }
	>
		<input type="hidden" name="_csrf" value={ csrf_token }/>
		if form.ErrorMessage != "" {
			<div class="col-span-full rounded-lg bg-red-100 p-4 text-sm text-red-700">
				{ form.ErrorMessage }
			</div>
		}
		<div class="md:col-span-2">
			@FormLabel("name", "Nome da Conta")
			@TextInput("name", "name", "text", form.Name, "Conta corrente principal", true)
		</div>
		<div>
			@FormLabel("type", "Tipo")
			@SelectInput("type", "type", buildAccountTypeOptions(form.Type), true)
		</div>
		<div>
			@FormLabel("currency", "Moeda")
			@TextInput("currency", "currency", "text", form.Currency, "", true)
		</div>
		<div>
			@FormLabel("opening_balance", "Saldo Inicial")
			@TextInput("opening_balance", "opening_balance", "text", form.OpeningBalance, "0.00", true)
		</div>
		<div>
			@FormLabel("opening_date", "Data Inicial")
			@TextInput("opening_date", "opening_date", "date", form.OpeningDate, "", false)
		</div>
		<div class="md:col-span-2 flex flex-col gap-3 sm:flex-row">
			@PrimaryButton("submit", accountFormSubmitLabel(form), true)
			if form.IsEdit {
				<button
					type="button"
					hx-get={ fmt.Sprintf("/account/%d", form.AccountID) }
					hx-target="closest li"
					hx-swap="outerHTML"
					class="inline-flex items-center justify-center rounded-xl border border-slate-300 px-4 text-sm font-semibold text-finops-800 transition hover:bg-slate-100"
				>Cancelar</button>
			}
		</div>
	</form>
}

templ Account(account store.Account) {
	<li class="flex items-center justify-between rounded-xl border border-slate-200 bg-slate-50 px-4 py-3">
		<div>
			<p class="font-semibold text-finops-900">{ account.Name }</p>
			<p class="text-sm text-finops-700">{ account.Type } • { account.Currency }</p>
		</div>
		<div class="flex items-center gap-3">
			<p class="text-sm font-bold text-finops-800">{ utils.FormatMoney(account.OpeningBalance) }</p>
			<span class="inline-flex size-9 items-center justify-center rounded-lg bg-slate-200 text-finops-500" title="Edicao em breve">
				<i class="fa-solid fa-pen-to-square"></i>
			</span>
		</div>
	</li>
}

