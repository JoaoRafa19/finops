package templates

import (
	"finops/internal/utils"
	"fmt"
)

templ AccountPanels(accounts []AccountItemDTO) {
	<div id="accounts-panel" class="rounded-2xl border border-slate-200 bg-white p-6">
		<div class="flex items-center justify-between">
			<p class="text-lg font-bold text-finops-900">Contas</p>
			<p class="mt-01 text-sm text-finops-700">Saldo atuais por conta</p>
		</div>
		if len(accounts) > 0 {
			<ul class="mt-6 space-y-3" id="accounts-list">
				for _, ac := range accounts {
					@AccountItem(ac)
				}
			</ul>
		} else {
			<p class="text-sm text-finops-700">Nenhuma conta cadastrada ainda.</p>
		}
	</div>
}

templ AccountModalDialog(form AccountFormState, csrf_token string) {
	<div class="p-6">
		<div class="flex items-center justify-between">
			<p class="text-lg font-bold text-finops-900">{ accountFormTitle(form) }</p>
			<form method="dialog">
				@DefaultCloseModalButton()
			</form>
		</div>
		<p class="mt-2 text-sm text-finops-700">{ accountFormDescription(form) }</p>
		@AccountForm(form, csrf_token)
	</div>
}

templ AccountManagePanels(accounts []AccountItemDTO, csrf string) {
	<div id="accounts-manage-panel" class="rounded-2xl border border-slate-200 bg-white p-6">
		<div class="flex items-center justify-between">
			<h2 class="text-sm font-bold uppercase tracking-wide text-finops-500">Contas bancárias</h2>
			<p class="text-xs text-finops-700">Gerencie suas contas cadastradas</p>
		</div>
		if len(accounts) > 0 {
			<ul class="mt-6 space-y-3" id="accounts-manage-list">
				for _, ac := range accounts {
					@AccountManageRow(ac, csrf)
				}
			</ul>
		} else {
			<p class="mt-4 text-sm text-finops-700">Nenhuma conta cadastrada ainda.</p>
		}
	</div>
}

templ AccountManageRow(account AccountItemDTO, csrf string) {
	<li
		id={ fmt.Sprintf("account-manage-%d", account.ID) }
		class="flex items-center justify-between rounded-xl border border-slate-200 bg-slate-50 px-4 py-3"
	>
		<div>
			<p class="font-semibold text-finops-900">{ account.Name }</p>
			<p class="text-sm text-finops-700">{ account.Type } • { account.Currency } • { utils.FormatMoney(account.CurrentBalance) }</p>
		</div>
		<div class="flex items-center gap-2">
			<button
				type="button"
				hx-get={ fmt.Sprintf("/accounts/%d/delete-modal", account.ID) }
				hx-target="#account-delete-modal-body"
				hx-swap="innerHTML"
				hx-on::after-request="document.getElementById('account-delete-modal')?.showModal()"
				class="inline-flex items-center rounded-lg bg-red-100 px-3 py-1.5 text-sm text-red-700 transition hover:bg-red-200"
				title="Excluir conta"
			><i class="fa-solid fa-trash"></i></button>
		</div>
	</li>
}

templ AccountDeleteModalDialog(id int64, name string, csrf string) {
	<div class="p-6">
		<div class="flex items-center justify-between">
			<p class="text-lg font-bold text-finops-900">Excluir conta</p>
			<form method="dialog">
				@DefaultCloseModalButton()
			</form>
		</div>
		<div class="mt-4 rounded-xl border-l-4 border-rose-500 bg-rose-50 p-4">
			<p class="text-sm text-rose-900">
				Todas as transações vinculadas à conta <strong>{ name }</strong> também serão <strong>excluídas permanentemente</strong>.
			</p>
			<p class="mt-2 text-sm text-rose-800">Esta ação não pode ser desfeita.</p>
		</div>
		<form
			method="post"
			hx-delete={ fmt.Sprintf("/accounts/%d", id) }
			hx-target={ fmt.Sprintf("#account-manage-%d", id) }
			hx-swap="outerHTML"
			hx-on::after-request="document.getElementById('account-delete-modal')?.close()"
			class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end"
		>
			<input type="hidden" name="_csrf" value={ csrf }/>
			<button
				type="button"
				onclick="document.getElementById('account-delete-modal')?.close()"
				class="inline-flex items-center justify-center rounded-xl border border-slate-300 px-4 py-2 text-sm font-semibold text-finops-800 transition hover:bg-slate-100"
			>Cancelar</button>
			<button
				type="submit"
				class="inline-flex items-center justify-center gap-2 rounded-xl bg-rose-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-rose-700"
			>
				<i class="fa-solid fa-trash"></i>
				Excluir permanentemente
			</button>
		</form>
	</div>
}

templ AccountItem(account AccountItemDTO) {
	<li
		id={ fmt.Sprintf("account-%d", account.ID) }
		class="flex items-center justify-between rounded-xl border border-slate-200 bg-slate-50 px-4 py-3"
	>
		<div>
			<p class="font-semibold text-finops-900">{ account.Name }</p>
			<p class="text-sm text-finops-700">{ account.Type } • { account.Currency }</p>
		</div>
		<div class="flex items-center gap-3">
			<p class="text-sm font-bold text-finops-800">{ utils.FormatMoney(account.CurrentBalance) }</p>
			<button
				type="button"
				hx-get={ fmt.Sprintf("/accounts/%d/edit", account.ID) }
				hx-target="#account-modal-body"
				hx-swap="innerHTML"
				hx-on::after-request="document.getElementById('account-modal')?.showModal()"
				class="inline-flex size-9 items-center justify-center rounded-lg bg-slate-200 text-finops-500 transition hover:bg-slate-300"
				title="Editar conta"
			><i class="fa-solid fa-pen-to-square"></i></button>
		</div>
	</li>
}

templ AccountForm(form AccountFormState, csrf_token string) {

	<form
		method="post"
		action={ accountFormAction(form) }
		hx-post={ accountFormAction(form) }
		hx-target="#account-modal-body"
		hx-swap="innerHTML"
		class="mt-6 grid gap-4 md:grid-cols-2"
	>
		<input type="hidden" name="_csrf" value={ csrf_token }/>
		if form.ErrorMessage != "" {
			<div class="col-span-full rounded-lg bg-red-100 p-4 text-sm text-red-700">
				{ form.ErrorMessage }
			</div>
		}
		<div class="md:col-span-2">
			@FormLabel("name", "Nome da Conta")
			@TextInput("name", "name", "text", form.Name, "Conta corrente principal", true)
		</div>
		<div>
			@FormLabel("type", "Tipo")
			@SelectInput("type", "type", buildAccountTypeOptions(form.Type), true)
		</div>
		<div>
			@FormLabel("currency", "Moeda")
			@TextInput("currency", "currency", "text", form.Currency, "", true)
		</div>
		<div>
			@FormLabel("current_balance", "Saldo Atual")
			@TextInput("current_balance", "current_balance", "text", form.CurrentBalance, "0.00", true)
		</div>
		<div class="md:col-span-2 flex flex-col gap-3 sm:flex-row">
			@PrimaryButton("submit", accountFormSubmitLabel(form), true)
			if form.IsEdit {
				<button
					type="button"
					onclick="document.getElementById('account-modal')?.close()"
					class="inline-flex items-center justify-center rounded-xl border border-slate-300 px-4 text-sm font-semibold text-finops-800 transition hover:bg-slate-100"
				>Cancelar</button>
			}
		</div>
	</form>
}
