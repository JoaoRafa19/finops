package templates

templ TourPage() {
	<!DOCTYPE html>
	<html lang="pt-BR">
		@AppHead("Bem-vindo ao Finops", false)
		<body class="min-h-screen bg-[radial-gradient(circle_at_top,_#99f6e4_0%,_#f8fafc_35%,_#e2e8f0_100%)] font-display text-finops-900">
			<!-- Reset do progresso salvo: chegar aqui significa recomeçar (ou pular) o tour -->
			<script>localStorage.removeItem("finops_tour_step");</script>
			<main class="mx-auto flex min-h-screen max-w-2xl items-center justify-center px-4 py-12">
				<div class="w-full rounded-3xl border border-white/80 bg-white/85 p-10 shadow-2xl shadow-finops-900/10 backdrop-blur-sm text-center">
					<div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-finops-900">
						<i class="fa-solid fa-coins text-2xl text-finops-400"></i>
					</div>
					<p class="text-xs font-bold uppercase tracking-[0.2em] text-finops-500">Finops</p>
					<h1 class="mt-3 text-4xl font-extrabold">Bem-vindo! 👋</h1>
					<p class="mt-4 text-base text-finops-700 max-w-md mx-auto">
						Antes de começar, vamos fazer um tour rápido pelo sistema para você conhecer todas as funcionalidades.
					</p>
					<div class="mt-8 rounded-2xl border border-slate-200 bg-slate-50 p-5 text-left space-y-3">
						<p class="text-sm font-bold text-finops-800">O que você vai ver:</p>
						<ul class="space-y-2 text-sm text-finops-700">
							<li class="flex items-center gap-2"><i class="fa-solid fa-house text-finops-400 w-4"></i> Painel de contas e saldo</li>
							<li class="flex items-center gap-2"><i class="fa-solid fa-chart-bar text-finops-400 w-4"></i> Relatórios financeiros</li>
							<li class="flex items-center gap-2"><i class="fa-solid fa-file-arrow-up text-finops-400 w-4"></i> Importação de extratos</li>
							<li class="flex items-center gap-2"><i class="fa-solid fa-tags text-finops-400 w-4"></i> Classificação automática por IA</li>
							<li class="flex items-center gap-2"><i class="fa-solid fa-robot text-finops-400 w-4"></i> Assistente financeiro</li>
						</ul>
						<p class="text-xs text-finops-500 mt-2">Dados de exemplo serão usados durante o tour e removidos ao final.</p>
					</div>
					<div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
						<a
							href="/tour/start"
							class="inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-xl bg-finops-900 px-8 py-3 text-sm font-bold text-white shadow-lg transition hover:bg-finops-800"
						>
							<i class="fa-solid fa-play"></i>
							Iniciar Tour
						</a>
						<a
							href="/tour/skip"
							class="inline-flex w-full sm:w-auto items-center justify-center rounded-xl border border-slate-300 px-8 py-3 text-sm font-semibold text-finops-700 transition hover:bg-slate-100"
						>
							Pular, já conheço o sistema
						</a>
					</div>
				</div>
			</main>
		</body>
	</html>
}
