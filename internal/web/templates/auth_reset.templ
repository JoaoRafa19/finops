package templates

templ ForgotPasswordPage(sent bool, errMsg string) {
	<!DOCTYPE html>
	<html lang="pt-BR">
		@AppHead("Esqueci minha senha - Finops", true)
		<body class="min-h-screen bg-[radial-gradient(circle_at_top,_#99f6e4_0%,_#f8fafc_35%,_#e2e8f0_100%)] font-display text-finops-900">
			<main class="mx-auto flex min-h-screen max-w-md items-center px-4 py-12">
				<div class="w-full rounded-3xl border border-white/80 bg-white/80 p-8 shadow-2xl shadow-finops-900/15 backdrop-blur-sm">
					<div class="mb-6">
						<a href="/login" class="mb-4 inline-flex items-center gap-1 text-sm text-finops-500 transition hover:text-finops-900">
							<i class="fa-solid fa-arrow-left text-xs"></i> Voltar ao login
						</a>
						<p class="text-xs font-bold uppercase tracking-[0.2em] text-finops-500">Recuperação de acesso</p>
						<h1 class="mt-2 text-3xl font-extrabold text-finops-900">Esqueci minha senha</h1>
					</div>
					if sent {
						<div class="rounded-xl bg-teal-50 p-4 text-sm text-teal-800">
							<i class="fa-solid fa-circle-check mr-2 text-teal-500"></i>
							Se este email estiver cadastrado, você receberá as instruções em breve. Verifique sua caixa de entrada.
						</div>
					} else {
						<p class="mb-6 text-sm text-finops-600">
							Digite seu email e enviaremos um link para criar uma nova senha.
						</p>
						if errMsg != "" {
							<div class="mb-4 rounded-xl bg-red-50 p-3 text-sm text-red-700">
								<i class="fa-solid fa-circle-exclamation mr-2"></i>{ errMsg }
							</div>
						}
						<form method="POST" action="/forgot-password" class="flex flex-col gap-4">
							<div>
								<label for="email" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-finops-600">Email</label>
								<input
									id="email"
									name="email"
									type="email"
									required
									placeholder="seu@email.com"
									class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm text-finops-900 outline-none focus:border-finops-500 focus:ring-2 focus:ring-finops-400/20"
								/>
							</div>
							<button
								type="submit"
								class="w-full rounded-xl bg-finops-900 py-3 text-sm font-bold text-white transition hover:bg-finops-800"
							>
								Enviar link de redefinição
							</button>
						</form>
					}
				</div>
			</main>
		</body>
	</html>
}

templ ResetPasswordPage(token, errMsg string) {
	<!DOCTYPE html>
	<html lang="pt-BR">
		@AppHead("Redefinir senha - Finops", true)
		<body class="min-h-screen bg-[radial-gradient(circle_at_top,_#99f6e4_0%,_#f8fafc_35%,_#e2e8f0_100%)] font-display text-finops-900">
			<main class="mx-auto flex min-h-screen max-w-md items-center px-4 py-12">
				<div class="w-full rounded-3xl border border-white/80 bg-white/80 p-8 shadow-2xl shadow-finops-900/15 backdrop-blur-sm">
					<div class="mb-6">
						<p class="text-xs font-bold uppercase tracking-[0.2em] text-finops-500">Nova senha</p>
						<h1 class="mt-2 text-3xl font-extrabold text-finops-900">Redefinir senha</h1>
					</div>
					if errMsg != "" {
						<div class="mb-4 rounded-xl bg-red-50 p-4 text-sm text-red-700">
							<i class="fa-solid fa-circle-exclamation mr-2"></i>{ errMsg }
							<div class="mt-3">
								<a href="/forgot-password" class="font-semibold underline">Solicitar novo link</a>
							</div>
						</div>
					} else {
						<form method="POST" action="/reset-password" class="flex flex-col gap-4">
							<input type="hidden" name="token" value={ token }/>
							<div>
								<label for="password" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-finops-600">Nova senha</label>
								<input
									id="password"
									name="password"
									type="password"
									required
									minlength="8"
									placeholder="Mínimo 8 caracteres"
									class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm text-finops-900 outline-none focus:border-finops-500 focus:ring-2 focus:ring-finops-400/20"
								/>
							</div>
							<div>
								<label for="password_confirm" class="mb-1 block text-xs font-semibold uppercase tracking-wide text-finops-600">Confirmar nova senha</label>
								<input
									id="password_confirm"
									name="password_confirm"
									type="password"
									required
									placeholder="Repita a senha"
									class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm text-finops-900 outline-none focus:border-finops-500 focus:ring-2 focus:ring-finops-400/20"
								/>
							</div>
							<button
								type="submit"
								class="w-full rounded-xl bg-finops-900 py-3 text-sm font-bold text-white transition hover:bg-finops-800"
							>
								Salvar nova senha
							</button>
						</form>
					}
				</div>
			</main>
		</body>
	</html>
}

templ ResetPasswordSuccessPage() {
	<!DOCTYPE html>
	<html lang="pt-BR">
		@AppHead("Senha redefinida - Finops", true)
		<body class="min-h-screen bg-[radial-gradient(circle_at_top,_#99f6e4_0%,_#f8fafc_35%,_#e2e8f0_100%)] font-display text-finops-900">
			<main class="mx-auto flex min-h-screen max-w-md items-center px-4 py-12">
				<div class="w-full rounded-3xl border border-white/80 bg-white/80 p-8 text-center shadow-2xl shadow-finops-900/15 backdrop-blur-sm">
					<div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-teal-100">
						<i class="fa-solid fa-check text-2xl text-teal-600"></i>
					</div>
					<h1 class="mb-2 text-2xl font-extrabold text-finops-900">Senha redefinida!</h1>
					<p class="mb-6 text-sm text-finops-600">Sua senha foi atualizada com sucesso. Faça login com a nova senha.</p>
					<a
						href="/login"
						class="inline-block rounded-xl bg-finops-900 px-6 py-3 text-sm font-bold text-white transition hover:bg-finops-800"
					>
						Ir para o login
					</a>
				</div>
			</main>
		</body>
	</html>
}
