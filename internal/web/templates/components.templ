package templates

import "fmt"

// SideNav renders the collapsible left sidebar. Pass the current path to highlight the active link.
templ SideNav(currentPath, csrf string) {
	<!-- Token CSRF no meta tag para uso global pelo HTMX -->
	<meta name="csrf-token" content={ csrf }/>
	<style>
		#page-content {
			transition: opacity 180ms ease, transform 180ms ease;
		}
		#page-content.htmx-swapping {
			opacity: 0;
			transform: translateY(var(--slide-out, -14px));
		}
		#page-content.htmx-settling {
			opacity: 0;
			transform: translateY(var(--slide-in, 14px));
		}
	</style>
	<script>
		document.addEventListener("htmx:configRequest", function(evt) {
			const token = document.querySelector("meta[name='csrf-token']")?.content;
			if (token) evt.detail.headers["X-CSRF-Token"] = token;
		});

		// SPA: ordem das páginas para determinar direcção do slide
		const _NAV_ORDER = { "/": 0, "/reports": 1, "/import": 2, "/classify": 3 };
		let _currentOrder = _NAV_ORDER[window.location.pathname] ?? 0;

		document.addEventListener("htmx:beforeRequest", function(evt) {
			if (evt.detail.target?.id !== "page-content") return;
			const targetPath = new URL(evt.detail.requestConfig.path, location.href).pathname;
			const targetOrder = _NAV_ORDER[targetPath] ?? _currentOrder;
			const el = document.getElementById("page-content");
			if (!el) return;
			if (targetOrder > _currentOrder) {
				el.style.setProperty("--slide-out", "-14px");
				el.style.setProperty("--slide-in",  "14px");
			} else {
				el.style.setProperty("--slide-out", "14px");
				el.style.setProperty("--slide-in",  "-14px");
			}
		});

		// Restaura foco no input de busca após swap do #report-content
		document.addEventListener("htmx:afterSettle", function(evt) {
			if (evt.detail.target?.id === "report-content") {
				const desc = document.querySelector('input[name="description"]');
				if (desc && desc.value) {
					desc.focus();
					desc.setSelectionRange(desc.value.length, desc.value.length);
				}
			}
		});

		document.addEventListener("htmx:afterSettle", function(evt) {
			if (evt.detail.target?.id !== "page-content") return;
			const path = window.location.pathname;
			_currentOrder = _NAV_ORDER[path] ?? _currentOrder;

			// Actualiza link activo na sidebar sem re-render
			document.querySelectorAll("[data-nav-path]").forEach(function(a) {
				const isActive = a.dataset.navPath === path;
				a.classList.toggle("bg-finops-900", isActive);
				a.classList.toggle("text-white", isActive);
				a.classList.toggle("hover:bg-finops-800", isActive);
				a.classList.toggle("text-finops-800", !isActive);
				a.classList.toggle("hover:bg-slate-100", !isActive);
			});
		});

		// Back/Forward do browser
		window.addEventListener("popstate", function() {
			const path = window.location.pathname;
			htmx.ajax("GET", path, {
				target: "#page-content",
				select: "#page-content",
				swap: "innerHTML settle:200ms",
			});
		});
	</script>
	@ChatWidget(csrf)
	<nav
		id="side-nav"
		class="group fixed left-0 top-0 z-50 flex h-full w-12 flex-col gap-1 overflow-hidden bg-white/95 py-6 shadow-lg shadow-finops-900/10 backdrop-blur-sm transition-[width] duration-200 hover:w-44"
	>
		<div class="mb-2 flex h-8 items-center px-3">
			<i class="fa-solid fa-coins w-6 shrink-0 text-center text-finops-500"></i>
			<span class="ml-3 whitespace-nowrap text-xs font-bold uppercase tracking-[0.2em] text-finops-500 opacity-0 transition-opacity duration-150 group-hover:opacity-100">Finops</span>
		</div>
		<!-- Bell de notificações com badge de pendentes -->
		<a
			href="/classify"
			class="relative mx-1 mb-3 flex items-center gap-3 rounded-xl px-2 py-2 text-sm font-semibold text-finops-800 transition hover:bg-slate-100"
			title="Transações pendentes de classificação"
		>
			<span class="relative w-6 shrink-0 text-center">
				<i class="fa-solid fa-bell text-finops-500"></i>
				<span
					id="pending-badge"
					hx-get="/notifications/count"
					hx-trigger="load"
					hx-swap="outerHTML"
					class="hidden"
				></span>
			</span>
			<span class="whitespace-nowrap opacity-0 transition-opacity duration-150 group-hover:opacity-100">
				Pendentes
				<span id="pending-badge-text" class="ml-1 rounded-full bg-rose-500 px-1.5 py-0.5 text-xs font-bold text-white opacity-0"></span>
			</span>
		</a>
		@sideNavLink("/", "fa-house", "Home", currentPath == "/")
		@sideNavLink("/reports", "fa-chart-bar", "Relatórios", currentPath == "/reports")
		@sideNavLink("/import", "fa-file-arrow-up", "Importar", currentPath == "/import")
		@sideNavLink("/classify", "fa-tags", "Classificar", currentPath == "/classify")
		<div class="mt-auto"></div>
		@sideNavLink("/profile", "fa-user", "Perfil", currentPath == "/profile")
	</nav>
	@tourScript(currentPath)
}

templ PendingBadge(count int) {
	if count > 0 {
		<span
			id="pending-badge"
			class="absolute -right-1 -top-1 flex h-4 min-w-4 items-center justify-center rounded-full bg-rose-500 px-1 text-[10px] font-bold text-white"
		>{ fmt.Sprintf("%d", count) }</span>
	} else {
		<span id="pending-badge" class="hidden"></span>
	}
}

templ sideNavLink(href, icon, label string, active bool) {
	<a
		data-nav-path={ href }
		href={ templ.SafeURL(href) }
		hx-get={ href }
		hx-target="#page-content"
		hx-select="#page-content"
		hx-swap="outerHTML settle:200ms"
		hx-push-url="true"
		class={
			"flex items-center gap-3 rounded-xl mx-1 px-2 py-2 text-sm font-semibold transition hover:bg-slate-100",
			templ.KV("bg-finops-900 text-white hover:bg-finops-800", active),
			templ.KV("text-finops-800", !active),
		}
	>
		<i class={ "fa-solid " + icon + " w-6 shrink-0 text-center" }></i>
		<span class="whitespace-nowrap opacity-0 transition-opacity duration-150 group-hover:opacity-100">{ label }</span>
	</a>
}

templ tourScript(currentPath string) {
	<script>
	(function() {
		const TOUR_KEY = "finops_tour_step";
		const params = new URLSearchParams(window.location.search);
		const isTourStart = params.get("tour") === "1";
		const savedStep  = parseInt(localStorage.getItem(TOUR_KEY) || "-1", 10);

		if (!isTourStart && savedStep < 0) return; // sem tour ativo

		const currentPath = window.location.pathname;

		// Definição completa dos passos
		const steps = [
			// Passo 0 — Home: Saldo total
			{ path: "/", element: "section", popover: { title: "💰 Saldo Total", description: "Aqui você vê o saldo consolidado de todas as suas contas.", side: "bottom" } },
			// Passo 1 — Home: Painel de contas
			{ path: "/", element: "#account-panels", popover: { title: "🏦 Suas Contas", description: "Cada conta aparece com seu saldo atual. Clique para ver detalhes e transações.", side: "top" } },
			// Passo 2 — Home: Transações recentes
			{ path: "/", element: "#transaction-panel", popover: { title: "📋 Transações Recentes", description: "As últimas movimentações ficam aqui — débitos e créditos de todas as contas.", side: "top" } },
			// Passo 3 — Home: Botões de ação
			{ path: "/", element: "#action-buttons", popover: { title: "⚡ Ações Rápidas", description: "Cadastre contas, registre transações e crie categorias com um clique.", side: "bottom" } },
			// Passo 4 — Home: Nav
			{ path: "/", element: "#side-nav", popover: { title: "🗂️ Navegação", description: "Acesse Relatórios, Importação e Classificação pelo menu lateral.", side: "right" } },
			// Passo 5 — Reports
			{ path: "/reports", element: "main", popover: { title: "📊 Relatórios", description: "Visualize seus gastos por categoria, compare receitas e despesas mês a mês e acompanhe a evolução do seu patrimônio.", side: "bottom" } },
			// Passo 6 — Reports: tabs
			{ path: "/reports", element: "#report-tabs", popover: { title: "📑 Abas de Relatório", description: "Alterne entre Gastos por Categoria, Receitas x Despesas, Evolução de Saldo e lista de Transações.", side: "bottom" } },
			// Passo 7 — Import
			{ path: "/import", element: "main", popover: { title: "📥 Importar Extratos", description: "Importe arquivos OFX do seu banco ou planilhas CSV. O sistema detecta duplicatas automaticamente.", side: "bottom" } },
			// Passo 8 — Classify
			{ path: "/classify", element: "main", popover: { title: "🏷️ Classificar Transações", description: "Transações sem categoria aparecem aqui. Classifique manualmente ou deixe a IA sugerir.", side: "bottom" } },
			// Passo 9 — Classify: AI button
			{ path: "/classify", element: "#auto-classify-btn", popover: { title: "🤖 Classificação por IA", description: "Clique aqui para deixar a IA classificar automaticamente todas as transações com base no seu histórico.", side: "bottom" } },
			// Passo 10 — Home: Chat
			{ path: "/", element: "#chat-open-btn", popover: { title: "💬 Assistente Financeiro", description: "Clique aqui para conversar com a IA. Pergunte coisas como: \"Quanto gastei este mês?\" ou \"Onde posso economizar?\"", side: "top" } },
		];

		// Filtra passos da página atual
		function stepsForPath(path) {
			return steps.map((s, i) => ({ ...s, originalIndex: i })).filter(s => s.path === path);
		}

		function navigateTo(path, nextOriginalIndex) {
			localStorage.setItem(TOUR_KEY, nextOriginalIndex.toString());
			window.location.href = path + "?tour=1";
		}

		function completeTour() {
			localStorage.removeItem(TOUR_KEY);
			window.location.href = "/tour/complete";
		}

		const pageSteps = stepsForPath(currentPath);
		if (pageSteps.length === 0) return;

		// Determina qual passo da página começar
		let startLocal = 0;
		if (!isTourStart && savedStep >= 0) {
			// Retomando — encontra o passo local que corresponde ao savedStep
			const found = pageSteps.findIndex(s => s.originalIndex >= savedStep);
			startLocal = found >= 0 ? found : 0;
		}

		// Monta a configuração do driver.js para essa página
		const driverSteps = pageSteps.map((s, localIdx) => {
			const isLastOnPage = localIdx === pageSteps.length - 1;
			const isVeryLast   = s.originalIndex === steps.length - 1;

			return {
				element:  s.element,
				popover:  {
					...s.popover,
					nextBtnText: isLastOnPage && !isVeryLast ? "Próxima tela →" : isVeryLast ? "Concluir tour 🎉" : "Próximo →",
					prevBtnText: "← Voltar",
				},
				onNextClick: isLastOnPage ? (isVeryLast
					? () => completeTour()
					: () => {
						// Próxima tela: acha o primeiro passo da próxima página
						const nextOrigIdx = pageSteps[pageSteps.length - 1].originalIndex + 1;
						if (nextOrigIdx < steps.length) {
							navigateTo(steps[nextOrigIdx].path, nextOrigIdx);
						}
					}
				) : undefined,
			};
		});

		// Aguarda DOM pronto e inicia
		document.addEventListener("DOMContentLoaded", function() {
			const d = window.driver.js.driver({
				animate:           true,
				overlayColor:      "#0f172a",
				overlayOpacity:    0.7,
				stagePadding:      8,
				allowClose:        false,
				disableActiveInteraction: false,
				steps: driverSteps,
				onDestroyStarted: () => {
					// Usuário fechou o tour manualmente — marca como concluído
					if (confirm("Sair do tour? Você pode reiniciá-lo pelo menu depois.")) {
						completeTour();
					}
				},
			});

			d.drive(startLocal);
		});
	})();
	</script>
}

templ AppHead(title string, includeHTMX bool) {
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<link rel="preconnect" href="https://fonts.googleapis.com"/>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
		<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;700;800&display=swap" rel="stylesheet"/>
		<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet"/>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/driver.js@1/dist/driver.css"/>
		<script src="https://cdn.tailwindcss.com"></script>
		if includeHTMX {
			<script src="https://unpkg.com/htmx.org@2.0.7"></script>
		}
		<script src="https://cdn.jsdelivr.net/npm/driver.js@1/dist/driver.js.iife.js"></script>
		<script>
			tailwind.config = {
				theme: {
					extend: {
						fontFamily: {
							display: ["Manrope", "sans-serif"],
						},
						colors: {
							finops: {
								900: "#0f172a",
								800: "#1e293b",
								700: "#334155",
								500: "#0ea5a4",
								400: "#2dd4bf",
							},
						},
					},
				},
			}
		</script>
		<title>{ title }</title>
	</head>
}

templ FormLabel(forID, text string) {
	<label for={ forID } class="mb-2 block text-sm font-bold text-finops-800">{ text }</label>
}

templ TextInput(id, name, inputType, value, placeholder string, required bool) {
	<input
		id={ id }
		type={ inputType }
		name={ name }
		value={ value }
		placeholder={ placeholder }
		if required {
			required
		}
		class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-finops-900 shadow-sm outline-none transition focus:border-finops-500 focus:ring-4 focus:ring-finops-400/20"
	/>
}

templ SelectInput(id, name string, options []SelectOption, required bool) {
	<select
		id={ id }
		name={ name }
		if required {
			required
		}
		class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-finops-900 shadow-sm outline-none transition focus:border-finops-500 focus:ring-4 focus:ring-finops-400/20"
	>
		for _, option := range options {
			<option
				value={ option.Value }
				if option.Selected {
					selected
				}
			>{ option.Label }</option>
		}
	</select>
}

templ PrimaryButton(buttonType, text string, fullWidth bool) {
	<button
		type={ buttonType }
		class={ primaryButtonClass(fullWidth) }
	>
		{ text }
	</button>
}

templ SecondaryButton(buttonType, text string) {
	<button
		type={ buttonType }
		class="inline-flex items-center justify-center rounded-xl border border-slate-300 px-4 py-3 text-sm font-semibold text-finops-800 transition hover:bg-slate-100"
	>
		{ text }
	</button>
}

templ SecondaryLink(href, text string) {
	<a
		href={ href }
		class="inline-flex items-center text-sm font-semibold text-finops-700 underline decoration-finops-400/70 underline-offset-4 transition hover:text-finops-900"
	>
		{ text }
	</a>
}

templ DefaultCloseModalButton() {
	<button
		type="submit"
		class="inline-flex size-9 items-center justify-center rounded-lg bg-slate-200 text-finops-500 transition hover:bg-slate-300"
		title="Fechar modal"
	><i class="fa-solid fa-xmark"></i></button>
}
